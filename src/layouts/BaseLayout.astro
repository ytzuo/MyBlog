---
import BaseHead from '../components/HeaderAndFooter/BaseHead.astro';
import Header from '../components/HeaderAndFooter/Header.astro';
import Footer from '../components/HeaderAndFooter/Footer.astro';
import type { ImageMetadata } from 'astro';
import { getLocaleFromPath, type Locale } from '../lib/i18n';

interface Props {
    title: string;
    description: string;
    image?: ImageMetadata;
    locale?: Locale;
    alternateUrl?: string;
    noindex?: boolean;
}

const {
    title,
    description,
    image,
    locale = getLocaleFromPath(Astro.url.pathname),
    alternateUrl,
    noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={locale === "en" ? "en" : "zh-CN"}>
    <head>
        <BaseHead
            title={title}
            description={description}
            image={image}
            locale={locale}
            alternateUrl={alternateUrl}
            noindex={noindex}
        />
        <slot name="head" />
    </head>
    <body>
        <div class="site-wrapper">
            <Header locale={locale} alternateUrl={alternateUrl} />
            <main>
                <slot />
            </main>
            <Footer locale={locale} />
        </div>
    </body>
</html>

<style>
    .site-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }
</style>
