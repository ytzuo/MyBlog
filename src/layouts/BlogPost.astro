---
import { Image } from "astro:assets";
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/HeaderAndFooter/BaseHead.astro";
import Footer from "../components/HeaderAndFooter/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/HeaderAndFooter/Header.astro";
import Tag from "../components/Tag.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import ReprintCard from "../components/ReprintCard.astro";
import type { ReadingStats } from "../lib/readingStats";

type Props = CollectionEntry<"blog">["data"] & {
    headings?: MarkdownHeading[];
    readingStats?: ReadingStats;
    showReadingProgress?: boolean;
};

const {
    title,
    description,
    pubDate,
    updatedDate,
    heroImage,
    heroImageScale = 1,
    tags,
    headings = [],
    readingStats,
    showReadingProgress = true,
    reprintAuthor,
    reprintUrl,
    reprintTitle,
} = Astro.props;

const tocHeadings = headings.filter(
    (heading) => heading.depth === 2 || heading.depth === 3,
);
const hasToc = tocHeadings.length > 0;
---

<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
        <style>
            .site-wrapper {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            main {
                width: min(1280px, calc(100% - 2rem));
                max-width: 100%;
                margin: 0 auto;
                flex: 1;
                box-sizing: border-box;
            }
            .hero-image {
                width: 100%;
            }
            .hero-image img {
                display: block;
                margin: 0 auto;
                border-radius: 10px;
                box-shadow: var(--box-shadow);
                height: auto;
                max-width: 100%;
            }
            .prose {
                width: min(1240px, 100%);
                margin: 0 auto;
                padding: 0;
                color: rgb(var(--gray-dark));
                box-sizing: border-box;
            }
            .title {
                margin-bottom: 0.5em;
                padding: 0.1em 0;
                text-align: center;
                line-height: 1;
            }
            .title h1 {
                margin: 0 0 0.5em 0;
                font-size: 1.9em;
            }
            /* 正文内各级标题缩小 */
            .prose :global(h1) {
                font-size: 1.7em;
            }
            .prose :global(h2) {
                font-size: 1.45em;
            }
            .prose :global(h3) {
                font-size: 1.2em;
            }
            .prose :global(h4) {
                font-size: 1.05em;
            }
            .prose :global(h5) {
                font-size: 0.95em;
            }
            .prose :global(h6) {
                font-size: 0.875em;
            }
            .prose :global(h2),
            .prose :global(h3),
            .prose :global(h4),
            .prose :global(h5),
            .prose :global(h6) {
                scroll-margin-top: var(--header-sticky-clearance, 6rem);
            }
            .date {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 0.35rem 0.65rem;
                margin-bottom: 0.1em;
                color: rgb(var(--gray));
            }
            .date-item:not(:last-child)::after {
                content: "·";
                margin-left: 0.65rem;
                color: rgba(var(--gray), 0.75);
            }
            .last-updated-on {
                flex-basis: 100%;
                font-style: italic;
            }
            .tags {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 0.5em;
                margin-top: 1em;
            }
            /* 正文段落自动首行缩进 */
            .prose :global(p) {
                text-indent: 2em;
                margin-bottom: 1em;
                line-height: 1.8;
            }
            /* 引用块内不缩进 */
            .prose :global(blockquote p) {
                text-indent: 0;
            }
            /* 列表内不缩进 */
            .prose :global(li p) {
                text-indent: 0;
            }
            /* 图片：block 居中，等比缩小，不拉伸 */
            .prose :global(img) {
                display: block;
                max-width: 100%;
                width: auto;
                height: auto;
                margin: 1.5rem auto;
            }
            /* 包含图片的段落取消首行缩进和文字居中影响 */
            .prose :global(p:has(> img)) {
                text-indent: 0;
                text-align: center;
                margin: 0;
            }

            .article-shell {
                display: block;
            }

            .article-shell.has-toc {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 17rem;
                gap: 1.65rem;
                align-items: start;
            }

            .article-content {
                min-width: 0;
            }

            .toc-panel {
                position: sticky;
                top: var(--header-sticky-clearance, 6rem);
                max-height: calc(100vh - var(--header-sticky-clearance, 6rem) - 1rem);
                overflow: auto;
                padding: 1rem 1.05rem;
                border-radius: 8px;
                border: 1px solid var(--surface-border);
                background: linear-gradient(180deg, var(--surface-1), var(--surface-2));
                box-shadow:
                    inset 0 1px 0 rgba(255, 255, 255, 0.62),
                    0 8px 18px var(--surface-shadow);
            }

            .toc-panel summary {
                list-style: none;
                cursor: default;
                color: rgb(var(--black));
                font-size: 1.05rem;
                font-weight: 800;
                line-height: 1.2;
            }

            .toc-panel summary::-webkit-details-marker {
                display: none;
            }

            .toc-title {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
            }

            .toc-title::before {
                content: "";
                width: 0.45rem;
                height: 0.45rem;
                border-radius: 999px;
                background: var(--accent);
                box-shadow: 0 0 0 4px rgba(112, 87, 23, 0.1);
            }

            .toc-list {
                display: flex;
                flex-direction: column;
                gap: 0.25rem;
                margin-top: 0.9rem;
            }

            .toc-link {
                display: block;
                border-radius: 6px;
                padding: 0.42rem 0.5rem;
                color: rgb(var(--gray-dark));
                font-size: 0.94rem;
                line-height: 1.35;
                text-decoration: none;
                transition:
                    background 0.18s ease,
                    color 0.18s ease,
                    transform 0.18s ease;
            }

            .toc-link.depth-3 {
                padding-left: 1.25rem;
                font-size: 0.87rem;
                color: rgb(var(--gray));
            }

            .toc-link:hover,
            .toc-link.is-active {
                background: rgba(112, 87, 23, 0.1);
                color: var(--accent-dark);
                transform: translateX(2px);
            }

            /* --- 代码块样式优化 --- */
            :global(.code-container) {
                position: relative;
                margin: 1.5rem 0;
                max-width: 100%;
                border-radius: 8px;
                border: 1px solid var(--gray-light, #e5e7eb);
                overflow: hidden;
            }

            /* 代码块顶部 header：语言标签 + 复制按钮 */
            :global(.code-header) {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.5rem;
                padding: 0.35rem 0.75rem 0.35rem 1rem;
                background: #1c1c1c;
                border-bottom: 1px solid rgba(255, 255, 255, 0.07);
                user-select: none;
            }

            :global(.code-lang) {
                font-family:
                    Consolas, Monaco, "Andale Mono", "Ubuntu Mono", monospace;
                font-size: 0.72rem;
                font-weight: 600;
                color: rgba(120, 210, 160, 0.85);
                letter-spacing: 0.06em;
                text-transform: lowercase;
                line-height: 1;
            }

            .prose :global(pre) {
                padding: 0;
                border-radius: 0;
                margin: 0;
                border: none;
                overflow-x: auto;
                overflow-y: hidden;
                -webkit-overflow-scrolling: touch;
                overscroll-behavior-x: contain;
            }

            .prose :global(pre)::before,
            .prose :global(pre)::after {
                display: none;
            }

            .prose :global(code) {
                font-family:
                    Consolas, Monaco, "Andale Mono", "Ubuntu Mono", monospace;
                font-size: 0.85em; /* 减小字体大小 */
                line-height: 1.5;
            }

            .prose :global(pre > code) {
                display: block;
                width: max-content;
                min-width: 100%;
                box-sizing: border-box;
                padding: 1rem;
                background:
                    radial-gradient(
                        circle,
                        rgba(18, 16, 16, 0) 0%,
                        rgba(0, 0, 0, 0.3) 100%
                    ),
                    linear-gradient(
                        rgba(18, 16, 16, 0) 50%,
                        rgba(0, 0, 0, 0.25) 50%
                    ),
                    linear-gradient(
                        90deg,
                        rgba(255, 0, 0, 0.06),
                        rgba(0, 255, 0, 0.02),
                        rgba(0, 0, 255, 0.06)
                    ),
                    #2c2c2c;
                background-size:
                    auto,
                    100% 2px,
                    3px 100%,
                    auto;
                background-repeat: no-repeat, repeat, repeat, no-repeat;
            }

            :global(html[data-theme="dark"]) .prose :global(pre > code) {
                background:
                    radial-gradient(
                        circle,
                        rgba(18, 16, 16, 0) 0%,
                        rgba(0, 0, 0, 0.36) 100%
                    ),
                    linear-gradient(
                        rgba(18, 16, 16, 0) 50%,
                        rgba(0, 0, 0, 0.28) 50%
                    ),
                    linear-gradient(
                        90deg,
                        rgba(255, 0, 0, 0.04),
                        rgba(0, 255, 0, 0.025),
                        rgba(0, 0, 255, 0.04)
                    ),
                    #212b23;
                background-size:
                    auto,
                    100% 2px,
                    3px 100%,
                    auto;
                background-repeat: no-repeat, repeat, repeat, no-repeat;
            }

            /* 内联代码样式 */
            .prose :global(p code),
            .prose :global(li code) {
                background-color: rgba(var(--accent), 0.12);
                color: rgb(var(--accent));
                padding: 0.2em 0.4em;
                border-radius: 4px;
                font-size: 0.9em;
            }

            /* 复制按钮样式（位于 code-header 内，非绝对定位） */
            :global(.copy-code-btn) {
                flex-shrink: 0;
                background-color: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 4px;
                color: #c0c0c0;
                font-size: 0.72rem;
                padding: 0.18rem 0.55rem;
                cursor: pointer;
                transition:
                    background-color 0.15s,
                    color 0.15s,
                    border-color 0.15s;
                line-height: 1.6;
                white-space: nowrap;
            }

            :global(.copy-code-btn:hover) {
                background-color: rgba(255, 255, 255, 0.16);
                color: #fff;
                border-color: rgba(255, 255, 255, 0.28);
            }

            :global(.copy-code-btn.copied) {
                background-color: var(--accent);
                border-color: var(--accent);
                color: #fff;
            }

            :global(.mermaid-container) {
                position: relative;
                margin: 1.5rem 0;
                padding: 1rem;
                border-radius: 8px;
                border: 1px solid rgba(126, 103, 64, 0.12);
                background: linear-gradient(180deg, #fffdf8, #f8f4ec);
                box-shadow:
                    inset 0 1px 0 rgba(255, 255, 255, 0.86),
                    0 4px 12px rgba(84, 70, 39, 0.05);
                overflow-x: auto;
            }

            :global(html[data-theme="dark"] .mermaid-container) {
                background: linear-gradient(180deg, #2b241d, #1f1a15);
                border-color: rgba(214, 183, 117, 0.18);
                box-shadow:
                    inset 0 1px 0 rgba(255, 244, 219, 0.06),
                    0 4px 12px rgba(0, 0, 0, 0.24);
            }

            :global(.mermaid-chart svg) {
                display: block;
                max-width: 100%;
                height: auto;
                margin: 0 auto;
            }

            /* Override prose paragraph indentation inside Mermaid labels */
            .prose :global(.mermaid-chart .label p),
            .prose :global(.mermaid-chart .nodeLabel p),
            .prose :global(.mermaid-chart foreignObject p) {
                margin: 0;
                text-indent: 0;
                text-align: center;
                line-height: 1.35;
            }

            :global(.mermaid-chart .edgePath .path),
            :global(.mermaid-chart .flowchart-link) {
                stroke: #000;
                stroke-width: 3.6px;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            :global(.mermaid-chart marker path) {
                fill: #000;
                stroke: #000;
                stroke-width: 2.4px;
            }

            :global(.mermaid-chart.mermaid-error) {
                color: #c0392b;
                font-size: 0.95rem;
                white-space: pre-wrap;
            }

            :global(.mermaid-zoom-btn) {
                display: none;
            }

            :global(.mermaid-zoom-modal) {
                position: fixed;
                inset: 0;
                z-index: 1000;
                display: none;
                flex-direction: column;
                background: rgba(18, 16, 14, 0.92);
                color: #fff;
                overscroll-behavior: none;
                touch-action: none;
            }

            :global(.mermaid-zoom-modal[data-open="true"]) {
                display: flex;
            }

            :global(.mermaid-zoom-toolbar) {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 0.5rem;
                padding: 0.75rem;
                background: rgba(0, 0, 0, 0.28);
                border-bottom: 1px solid rgba(255, 255, 255, 0.12);
                touch-action: manipulation;
            }

            :global(.mermaid-zoom-action) {
                width: 2.25rem;
                height: 2.25rem;
                border: 1px solid rgba(255, 255, 255, 0.18);
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.1);
                color: #fff;
                font: inherit;
                line-height: 1;
                cursor: pointer;
                touch-action: manipulation;
                -webkit-tap-highlight-color: transparent;
            }

            :global(.mermaid-zoom-viewport) {
                flex: 1;
                overflow: hidden;
                touch-action: none;
                position: relative;
            }

            :global(.mermaid-zoom-content) {
                position: absolute;
                top: 50%;
                left: 50%;
                transform-origin: 0 0;
                will-change: transform;
            }

            :global(.mermaid-zoom-content svg) {
                display: block;
                max-width: none;
                height: auto;
                background: #fffdf8;
                border-radius: 8px;
                box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
            }

            @media (max-width: 720px) {
                :global(.code-container) {
                    width: auto;
                    max-width: 100%;
                    margin: 1.25rem 0;
                    box-sizing: border-box;
                    border-radius: 8px;
                }

                :global(.code-header) {
                    border-radius: 8px 8px 0 0;
                }

                .prose :global(pre code) {
                    font-size: 0.8rem;
                    padding: 0.9rem 0.9rem 0.9rem 1rem;
                }

                :global(.mermaid-container) {
                    padding: 0.9rem;
                }

                :global(.mermaid-zoom-btn) {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    position: absolute;
                    top: 0.5rem;
                    right: 0.5rem;
                    width: 2rem;
                    height: 2rem;
                    border: 1px solid rgba(126, 103, 64, 0.18);
                    border-radius: 999px;
                    background: rgba(255, 255, 255, 0.82);
                    color: rgb(var(--black));
                    box-shadow: 0 4px 12px rgba(84, 70, 39, 0.14);
                    cursor: pointer;
                    -webkit-tap-highlight-color: transparent;
                }

                :global(.mermaid-zoom-btn svg) {
                    width: 1rem;
                    height: 1rem;
                }

                :global(html[data-theme="dark"]) :global(.mermaid-zoom-btn) {
                    background: rgba(43, 36, 29, 0.9);
                    border-color: rgba(214, 183, 117, 0.18);
                    color: rgb(var(--black));
                }
                .title h1 {
                    font-size: 1.5em;
                }
                .prose :global(h1) {
                    font-size: 1.4em;
                }
                .prose :global(h2) {
                    font-size: 1.25em;
                }
                .prose :global(h3) {
                    font-size: 1.1em;
                }
                .prose :global(h4) {
                    font-size: 1em;
                }
                .prose :global(h5) {
                    font-size: 0.9em;
                }
                .prose :global(h6) {
                    font-size: 0.85em;
                }
            }

            @media (max-width: 980px) {
                .article-shell.has-toc {
                    display: flex;
                    flex-direction: column;
                    gap: 1.25rem;
                }

                .toc-panel {
                    position: static;
                    order: -1;
                    width: 100%;
                    max-height: none;
                    box-sizing: border-box;
                }

                .toc-panel summary {
                    cursor: pointer;
                }

                .toc-panel summary::after {
                    content: "▾";
                    float: right;
                    color: var(--accent);
                    font-size: 0.8rem;
                    transition: transform 0.2s ease;
                }

                .toc-panel:not([open]) summary::after {
                    transform: rotate(-90deg);
                }
            }

            /* --- 电子表格样式 --- */
            .prose :global(table) {
                width: 100%;
                border-collapse: collapse;
                margin: 2rem 0;
                font-size: 1.1rem; /* 再次加大字体 */
                box-shadow: 0 0 0 1px #e0e0e0; /* 外边框 */
                border-radius: 4px;
                overflow: hidden;
                background-color: #fff; /* 整体白色背景 */
            }

            .prose :global(th),
            .prose :global(td) {
                padding: 0.75rem 1rem;
                border: 1px solid #e0e0e0;
                text-align: left;
            }

            /* 表头样式 - 模仿 Excel 列头 */
            .prose :global(thead) {
                background-color: #f8f9fa;
                border-bottom: 2px solid #dee2e6;
            }

            .prose :global(tbody tr) {
                background-color: #fff; /* 默认行背景 */
            }

            .prose :global(th) {
                font-weight: 600;
                color: #495057;
                position: relative;
            }

            /* 条纹背景 */
            .prose :global(tbody tr:nth-child(even)) {
                background-color: #f8f9fa;
            }

            /* 悬停效果 - 模仿选中行 */
            .prose :global(tbody tr:hover) {
                background-color: rgba(var(--accent), 0.05);
            }

            :global(html[data-theme="dark"]) .prose :global(table) {
                background-color: #1f1a15;
                box-shadow: 0 0 0 1px rgba(214, 183, 117, 0.18);
                color: rgb(var(--gray-dark));
            }

            :global(html[data-theme="dark"]) .prose :global(th),
            :global(html[data-theme="dark"]) .prose :global(td) {
                border-color: rgba(214, 183, 117, 0.18);
            }

            :global(html[data-theme="dark"]) .prose :global(thead) {
                background-color: #2b241d;
                border-bottom-color: rgba(214, 183, 117, 0.28);
            }

            :global(html[data-theme="dark"]) .prose :global(tbody tr) {
                background-color: #1f1a15;
            }

            :global(html[data-theme="dark"]) .prose :global(th) {
                color: rgb(var(--black));
            }

            :global(html[data-theme="dark"])
                .prose
                :global(tbody tr:nth-child(even)) {
                background-color: #251f19;
            }

            :global(html[data-theme="dark"]) .prose :global(tbody tr:hover) {
                background-color: rgba(212, 176, 103, 0.12);
            }

            /* 单元格数字右对齐 (可选，需根据内容判断，这里暂不强制) */
        </style>
    </head>

    <body>
        {
            showReadingProgress && (
                <ReadingProgress
                    height={5}
                    throttleDelay={16}
                    showPercentage={true}
                />
            )
        }
        <div class="site-wrapper">
            <Header />
            <main>
                <!-- 顶部大图 -->
                <div class="hero-image">
                    {
                        heroImage && (
                            <Image
                                width={1020}
                                src={heroImage}
                                alt=""
                                style={`width: ${heroImageScale * 100}%; height: auto;`}
                            />
                        )
                    }
                </div>
                <br />
                <div class="prose">
                    <div class="title">
                        <h1>{title}</h1>
                        <div class="date">
                            <span class="date-item">
                                <FormattedDate date={pubDate} />
                            </span>
                            {
                                readingStats && (
                                    <>
                                        <span class="date-item">
                                            {readingStats.wordCountText}
                                        </span>
                                        <span class="date-item">
                                            {readingStats.readingTimeText}
                                        </span>
                                    </>
                                )
                            }
                            {
                                updatedDate && (
                                    <div class="last-updated-on">
                                        Last updated on{" "}
                                        <FormattedDate date={updatedDate} />
                                    </div>
                                )
                            }
                        </div>
                        <!-- 标签展示 -->
                        {
                            tags && tags.length > 0 && (
                                <div class="tags">
                                    {tags.map((tag) => (
                                        <Tag tag={tag} />
                                    ))}
                                </div>
                            )
                        }
                        <hr />
                    </div>
                    <!-- 转载声明卡片 -->
                    {
                        reprintAuthor && reprintUrl && (
                            <ReprintCard
                                author={reprintAuthor}
                                url={reprintUrl}
                                title={reprintTitle}
                            />
                        )
                    }
                    <div class:list={["article-shell", { "has-toc": hasToc }]}>
                        <article class="article-content">
                            <!-- 文章内容插槽 -->
                            <slot />
                        </article>
                        {
                            hasToc && (
                                <aside class="toc-panel" aria-label="文章目录">
                                    <details open>
                                        <summary>
                                            <span class="toc-title">文章目录</span>
                                        </summary>
                                        <nav class="toc-list">
                                            {tocHeadings.map((heading) => (
                                                <a
                                                    class:list={[
                                                        "toc-link",
                                                        `depth-${heading.depth}`,
                                                    ]}
                                                    href={`#${heading.slug}`}
                                                    data-toc-link
                                                    data-heading-id={heading.slug}
                                                >
                                                    {heading.text}
                                                </a>
                                            ))}
                                        </nav>
                                    </details>
                                </aside>
                            )
                        }
                    </div>
                </div>
            </main>
            <Footer />
        </div>
        <script>
            import mermaid from "mermaid";

            let tocObserver: IntersectionObserver | null = null;
            let themeObserverAttached = false;
            const globalWindow = window as Window & {
                __MERMAID_DEBUG__?: {
                    enabled: boolean;
                    entries: Array<{
                        index: number;
                        lineCount: number;
                        charCount: number;
                        ok: boolean;
                        message?: string;
                    }>;
                };
            };

            const MERMAID_DEBUG = (() => {
                try {
                    const params = new URLSearchParams(window.location.search);
                    if (
                        params.get("mermaidDebug") === "1" ||
                        params.has("mermaidDebug")
                    )
                        return true;
                    return localStorage.getItem("mermaid-debug") === "1";
                } catch {
                    return false;
                }
            })();

            if (!globalWindow.__MERMAID_DEBUG__) {
                globalWindow.__MERMAID_DEBUG__ = {
                    enabled: MERMAID_DEBUG,
                    entries: [],
                };
            }

            const debugLog = (...args: unknown[]) => {
                if (!MERMAID_DEBUG) return;
                console.log("[Mermaid Debug]", ...args);
            };

            const initArticleToc = () => {
                tocObserver?.disconnect();
                const links = Array.from(
                    document.querySelectorAll<HTMLAnchorElement>(
                        "[data-toc-link]",
                    ),
                );
                if (links.length === 0) return;

                const linkById = new Map(
                    links.map((link) => [link.dataset.headingId, link]),
                );
                const headings = links
                    .map((link) =>
                        link.dataset.headingId
                            ? document.getElementById(link.dataset.headingId)
                            : null,
                    )
                    .filter((heading): heading is HTMLElement =>
                        Boolean(heading),
                    );

                const setActiveLink = (id: string) => {
                    links.forEach((link) =>
                        link.classList.toggle(
                            "is-active",
                            link.dataset.headingId === id,
                        ),
                    );
                };

                tocObserver = new IntersectionObserver(
                    (entries) => {
                        const visibleEntry = entries
                            .filter((entry) => entry.isIntersecting)
                            .sort(
                                (a, b) =>
                                    a.boundingClientRect.top -
                                    b.boundingClientRect.top,
                            )[0];

                        if (visibleEntry?.target.id) {
                            setActiveLink(visibleEntry.target.id);
                        }
                    },
                    {
                        rootMargin: "-20% 0px -68% 0px",
                        threshold: 0,
                    },
                );

                headings.forEach((heading) => tocObserver?.observe(heading));
                const firstId = headings[0]?.id;
                if (firstId && linkById.has(firstId)) {
                    setActiveLink(firstId);
                }
            };

            document.addEventListener("astro:page-load", initArticleToc);

            const isDynamicImportFetchError = (message: string): boolean =>
                /Failed to fetch dynamically imported module/i.test(message);

            const tryDevAutoReload = (): boolean => {
                if (!import.meta.env.DEV) return false;

                const key = "mermaid-dev-reload-once";
                if (sessionStorage.getItem(key) === "1") return false;

                sessionStorage.setItem(key, "1");
                setTimeout(() => {
                    window.location.reload();
                }, 80);
                return true;
            };

            const escapeHtml = (input: string): string =>
                input
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#39;");

            const getMermaidTheme = (): "default" => "default";

            const isMermaidCodeBlock = (
                pre: Element | null,
                code: Element | null,
            ): boolean => {
                if (!pre && !code) return false;

                const preLanguage =
                    pre instanceof HTMLElement ? pre.dataset.language : "";
                if (preLanguage?.toLowerCase() === "mermaid") return true;

                const preClassName = pre?.className || "";
                if (/(^|\s)language-mermaid(\s|$)/.test(preClassName))
                    return true;

                const codeClassName = code?.className || "";
                return /(^|\s)language-mermaid(\s|$)/.test(codeClassName);
            };

            const initializeMermaid = () => {
                mermaid.initialize({
                    startOnLoad: false,
                    theme: getMermaidTheme(),
                    securityLevel: "loose",
                });
            };

            const extractMermaidSource = (code: HTMLElement): string => {
                const lines = Array.from(code.querySelectorAll(".line"));
                const raw =
                    lines.length > 0
                        ? lines.map((line) => line.textContent || "").join("\n")
                        : code.textContent || "";

                return raw
                    .replace(/\u00A0/g, " ")
                    .replace(/[\u200B-\u200D\uFEFF]/g, "")
                    .replace(
                        /[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/g,
                        "",
                    )
                    .replace(/\r\n?/g, "\n")
                    .trim();
            };

            const validateMermaidSource = async (
                source: string,
            ): Promise<{ ok: boolean; message?: string }> => {
                try {
                    await mermaid.parse(source);
                    return { ok: true };
                } catch (error) {
                    return {
                        ok: false,
                        message:
                            error instanceof Error
                                ? error.message
                                : String(error),
                    };
                }
            };

            const renderMermaidChart = async (
                container: HTMLElement,
                index: number,
            ): Promise<void> => {
                const source = container.dataset.mermaidSource;
                if (!source) return;

                const lines = source.split("\n");
                const sourceMeta = {
                    lineCount: lines.length,
                    charCount: source.length,
                    preview: lines.slice(0, 8).join("\n"),
                };

                debugLog(`Start render #${index}`, sourceMeta);

                try {
                    if (MERMAID_DEBUG) {
                        const validation = await validateMermaidSource(source);
                        if (!validation.ok) {
                            throw new Error(
                                `Pre-parse failed: ${validation.message || "unknown mermaid parse error"}`,
                            );
                        }
                    }

                    const { svg, bindFunctions } = await mermaid.render(
                        `mermaid-${index}-${Date.now()}`,
                        source,
                    );
                    sessionStorage.removeItem("mermaid-dev-reload-once");
                    container.classList.remove("mermaid-error");
                    container.innerHTML = svg;
                    globalWindow.__MERMAID_DEBUG__?.entries.push({
                        index,
                        lineCount: sourceMeta.lineCount,
                        charCount: sourceMeta.charCount,
                        ok: true,
                    });
                    debugLog(`Render success #${index}`);
                    if (bindFunctions) {
                        bindFunctions(container);
                    }
                } catch (error) {
                    const message =
                        error instanceof Error ? error.message : String(error);

                    if (
                        isDynamicImportFetchError(message) &&
                        tryDevAutoReload()
                    ) {
                        container.classList.add("mermaid-error");
                        container.innerHTML =
                            "<p>检测到 Mermaid 动态模块缓存失效，正在自动刷新页面重试...</p>";
                        return;
                    }

                    console.groupCollapsed(
                        `[Mermaid Debug] Render failed #${index}`,
                    );
                    console.error("Error:", error);
                    console.info("Theme:", getMermaidTheme());
                    console.info("Source meta:", sourceMeta);
                    console.info("Source full text:\n" + source);
                    console.groupEnd();

                    globalWindow.__MERMAID_DEBUG__?.entries.push({
                        index,
                        lineCount: sourceMeta.lineCount,
                        charCount: sourceMeta.charCount,
                        ok: false,
                        message,
                    });

                    container.classList.add("mermaid-error");
                    const extraHint = isDynamicImportFetchError(message)
                        ? "开发环境模块缓存可能失效，请 Ctrl+F5 强刷，或重启 dev（建议: pnpm dev -- --force）。"
                        : "";
                    container.innerHTML = `
						<p>Mermaid 图表渲染失败，请打开控制台查看详细日志。</p>
						<p>错误信息: ${escapeHtml(message)}</p>
						${extraHint ? `<p>${escapeHtml(extraHint)}</p>` : ""}
						<pre>${escapeHtml(sourceMeta.preview)}</pre>
					`;
                }
            };

            const renderMermaidDiagrams = async () => {
                initializeMermaid();

                const mermaidCodeBlocks =
                    document.querySelectorAll(".prose pre > code");
                let index = 0;

                for (const code of mermaidCodeBlocks) {
                    if (!(code instanceof HTMLElement)) continue;

                    const pre = code.parentElement;
                    if (!isMermaidCodeBlock(pre, code)) continue;

                    if (!pre) continue;

                    if (pre.dataset.mermaidMounted === "true") continue;

                    const source = extractMermaidSource(code);
                    if (!source) continue;

                    const wrapper = document.createElement("div");
                    wrapper.className = "mermaid-container";

                    const chart = document.createElement("div");
                    chart.className = "mermaid-chart";
                    chart.dataset.mermaidSource = source;

                    wrapper.appendChild(chart);
                    pre.dataset.mermaidMounted = "true";
                    pre.replaceWith(wrapper);

                    await renderMermaidChart(chart, index++);
                }
            };

            const rerenderMermaidDiagrams = async () => {
                initializeMermaid();
                const charts = document.querySelectorAll(
                    ".mermaid-chart[data-mermaid-source]",
                );

                let index = 0;
                for (const chart of charts) {
                    if (!(chart instanceof HTMLElement)) continue;
                    await renderMermaidChart(chart, index++);
                }
            };

            const createMermaidZoomModal = (): HTMLElement => {
                const existing = document.querySelector(
                    ".mermaid-zoom-modal",
                );
                if (existing instanceof HTMLElement) return existing;

                const modal = document.createElement("div");
                modal.className = "mermaid-zoom-modal";
                modal.setAttribute("aria-hidden", "true");
                modal.innerHTML = `
                    <div class="mermaid-zoom-toolbar">
                        <button class="mermaid-zoom-action" data-action="zoom-out" aria-label="缩小">-</button>
                        <button class="mermaid-zoom-action" data-action="reset" aria-label="重置">1:1</button>
                        <button class="mermaid-zoom-action" data-action="zoom-in" aria-label="放大">+</button>
                        <button class="mermaid-zoom-action" data-action="close" aria-label="关闭">×</button>
                    </div>
                    <div class="mermaid-zoom-viewport">
                        <div class="mermaid-zoom-content"></div>
                    </div>
                `;
                document.body.appendChild(modal);
                return modal;
            };

            const openMermaidZoom = (chart: HTMLElement) => {
                const sourceSvg = chart.querySelector("svg");
                if (!(sourceSvg instanceof SVGSVGElement)) return;

                const modal = createMermaidZoomModal();
                const viewport = modal.querySelector(
                    ".mermaid-zoom-viewport",
                ) as HTMLElement | null;
                const content = modal.querySelector(
                    ".mermaid-zoom-content",
                ) as HTMLElement | null;
                if (!viewport || !content) return;

                content.innerHTML = "";
                const svg = sourceSvg.cloneNode(true) as SVGSVGElement;
                svg.removeAttribute("style");
                svg.style.maxWidth = "none";
                content.appendChild(svg);

                const sourceRect = sourceSvg.getBoundingClientRect();
                const viewBox = sourceSvg.viewBox.baseVal;
                const baseWidth = Math.max(
                    1,
                    viewBox.width || sourceRect.width || 320,
                );
                const baseHeight = Math.max(
                    1,
                    viewBox.height || sourceRect.height || 240,
                );

                const pointers = new Map<number, PointerEvent>();
                let scale = 1;
                let translateX = 0;
                let translateY = 0;
                let startX = 0;
                let startY = 0;
                let baseX = 0;
                let baseY = 0;
                let startDistance = 0;
                let startScale = 1;
                const gestureAbortController = new AbortController();

                const clampScale = (value: number) =>
                    Math.min(6, Math.max(0.4, value));

                const applyTransform = () => {
                    svg.style.width = `${baseWidth * scale}px`;
                    svg.style.height = `${baseHeight * scale}px`;
                    content.style.transform = `translate(calc(-50% + ${translateX}px), calc(-50% + ${translateY}px))`;
                };

                const reset = () => {
                    scale = 1;
                    translateX = 0;
                    translateY = 0;
                    applyTransform();
                };

                const getDistance = () => {
                    const active = [...pointers.values()];
                    if (active.length < 2) return 0;
                    return Math.hypot(
                        active[0].clientX - active[1].clientX,
                        active[0].clientY - active[1].clientY,
                    );
                };

                const close = () => {
                    modal.dataset.open = "false";
                    modal.setAttribute("aria-hidden", "true");
                    document.body.style.overflow = "";
                    pointers.clear();
                    gestureAbortController.abort();
                    viewport.onpointerdown = null;
                    viewport.onpointermove = null;
                    viewport.onpointerup = null;
                    viewport.onpointercancel = null;
                };

                modal.dataset.open = "true";
                modal.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
                reset();

                const preventPageGesture = (event: Event) => {
                    event.preventDefault();
                };

                modal.addEventListener("touchmove", preventPageGesture, {
                    passive: false,
                    signal: gestureAbortController.signal,
                });
                modal.addEventListener("gesturestart", preventPageGesture, {
                    passive: false,
                    signal: gestureAbortController.signal,
                });
                modal.addEventListener("gesturechange", preventPageGesture, {
                    passive: false,
                    signal: gestureAbortController.signal,
                });
                modal.addEventListener("gestureend", preventPageGesture, {
                    passive: false,
                    signal: gestureAbortController.signal,
                });

                viewport.onpointerdown = (event) => {
                    event.preventDefault();
                    viewport.setPointerCapture(event.pointerId);
                    pointers.set(event.pointerId, event);

                    if (pointers.size === 1) {
                        startX = event.clientX;
                        startY = event.clientY;
                        baseX = translateX;
                        baseY = translateY;
                    } else if (pointers.size === 2) {
                        startDistance = getDistance();
                        startScale = scale;
                    }
                };

                viewport.onpointermove = (event) => {
                    event.preventDefault();
                    if (!pointers.has(event.pointerId)) return;
                    pointers.set(event.pointerId, event);

                    if (pointers.size === 1) {
                        translateX = baseX + event.clientX - startX;
                        translateY = baseY + event.clientY - startY;
                    } else if (pointers.size === 2 && startDistance > 0) {
                        scale = clampScale(
                            startScale * (getDistance() / startDistance),
                        );
                    }
                    applyTransform();
                };

                const releasePointer = (event: PointerEvent) => {
                    pointers.delete(event.pointerId);
                    if (pointers.size === 1) {
                        const remaining = [...pointers.values()][0];
                        startX = remaining.clientX;
                        startY = remaining.clientY;
                        baseX = translateX;
                        baseY = translateY;
                    }
                };

                viewport.onpointerup = releasePointer;
                viewport.onpointercancel = releasePointer;

                modal.onclick = (event) => {
                    const target = event.target as HTMLElement;
                    const action = target.closest<HTMLElement>("[data-action]")
                        ?.dataset.action;
                    if (!action) return;

                    if (action === "close") close();
                    if (action === "reset") reset();
                    if (action === "zoom-in") {
                        scale = clampScale(scale * 1.25);
                        applyTransform();
                    }
                    if (action === "zoom-out") {
                        scale = clampScale(scale / 1.25);
                        applyTransform();
                    }
                };
            };

            const addMermaidZoomControls = () => {
                document
                    .querySelectorAll<HTMLElement>(".mermaid-container")
                    .forEach((container) => {
                        if (container.querySelector(".mermaid-zoom-btn"))
                            return;

                        const chart =
                            container.querySelector<HTMLElement>(
                                ".mermaid-chart",
                            );
                        if (!chart || chart.classList.contains("mermaid-error"))
                            return;

                        const button = document.createElement("button");
                        button.className = "mermaid-zoom-btn";
                        button.type = "button";
                        button.setAttribute("aria-label", "放大查看图表");
                        button.innerHTML = `
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M10.5 4a6.5 6.5 0 0 1 5.15 10.46l4.45 4.44-1.2 1.2-4.44-4.45A6.5 6.5 0 1 1 10.5 4Zm0 1.7a4.8 4.8 0 1 0 0 9.6 4.8 4.8 0 0 0 0-9.6Zm.85 2.1v1.85h1.85v1.7h-1.85v1.85h-1.7v-1.85H7.8v-1.7h1.85V7.8h1.7Z" fill="currentColor"/>
                            </svg>
                        `;
                        button.addEventListener("click", () =>
                            openMermaidZoom(chart),
                        );
                        container.appendChild(button);
                    });
            };

            const observeThemeChanges = () => {
                if (themeObserverAttached) return;
                themeObserverAttached = true;

                const observer = new MutationObserver((mutations) => {
                    for (const mutation of mutations) {
                        if (
                            mutation.type === "attributes" &&
                            mutation.attributeName === "data-theme"
                        ) {
                            void rerenderMermaidDiagrams();
                            break;
                        }
                    }
                });

                observer.observe(document.documentElement, {
                    attributes: true,
                    attributeFilter: ["data-theme"],
                });
            };

            // 从 pre/code 元素提取语言标识
            const extractLanguage = (
                pre: HTMLElement,
                code: HTMLElement,
            ): string => {
                const fromData = pre.dataset.language || "";
                if (fromData) return fromData;
                const match = code.className.match(/(?:^|\s)language-(\S+)/);
                return match ? match[1] : "";
            };

            // 语言标识 → 友好显示名
            const formatLangLabel = (lang: string): string => {
                const map: Record<string, string> = {
                    js: "JavaScript",
                    javascript: "JavaScript",
                    ts: "TypeScript",
                    typescript: "TypeScript",
                    jsx: "JSX",
                    tsx: "TSX",
                    java: "Java",
                    kotlin: "Kotlin",
                    kt: "Kotlin",
                    py: "Python",
                    python: "Python",
                    go: "Go",
                    rs: "Rust",
                    rust: "Rust",
                    rb: "Ruby",
                    php: "PHP",
                    swift: "Swift",
                    cs: "C#",
                    cpp: "C++",
                    c: "C",
                    sh: "Shell",
                    bash: "Bash",
                    zsh: "Zsh",
                    css: "CSS",
                    scss: "SCSS",
                    less: "Less",
                    html: "HTML",
                    xml: "XML",
                    svg: "SVG",
                    json: "JSON",
                    yaml: "YAML",
                    yml: "YAML",
                    toml: "TOML",
                    md: "Markdown",
                    mdx: "MDX",
                    sql: "SQL",
                    astro: "Astro",
                    vue: "Vue",
                    svelte: "Svelte",
                    text: "",
                    txt: "",
                    plaintext: "",
                };
                const key = lang.toLowerCase();
                return key in map ? map[key] : lang;
            };

            // 为代码块添加顶部 header（语言标签 + 复制按钮）
            const addCopyButtons = () => {
                const preBlocks = document.querySelectorAll(".prose pre");

                preBlocks.forEach((pre) => {
                    if (!(pre instanceof HTMLElement)) return;
                    const code = pre.querySelector("code");
                    if (!code || isMermaidCodeBlock(pre, code)) return;

                    // 避免重复添加
                    if (pre.parentElement?.classList.contains("code-container"))
                        return;

                    // 创建 wrapper
                    const wrapper = document.createElement("div");
                    wrapper.className = "code-container";

                    // 插入 wrapper
                    pre.parentNode?.insertBefore(wrapper, pre);
                    wrapper.appendChild(pre);

                    // 创建 header 栏
                    const header = document.createElement("div");
                    header.className = "code-header";

                    // 语言标签（左侧）
                    const rawLang = extractLanguage(pre, code as HTMLElement);
                    const langLabel = formatLangLabel(rawLang);
                    const langSpan = document.createElement("span");
                    langSpan.className = "code-lang";
                    langSpan.textContent = langLabel;
                    header.appendChild(langSpan);

                    // 复制按钮（右侧）
                    const button = document.createElement("button");
                    button.className = "copy-code-btn";
                    button.textContent = "Copy";
                    button.addEventListener("click", async () => {
                        try {
                            await navigator.clipboard.writeText(
                                code.textContent || "",
                            );
                            const orig = button.textContent;
                            button.textContent = "Copied!";
                            button.classList.add("copied");
                            setTimeout(() => {
                                button.textContent = orig;
                                button.classList.remove("copied");
                            }, 2000);
                        } catch (err) {
                            console.error("Failed to copy:", err);
                            button.textContent = "Error";
                        }
                    });
                    header.appendChild(button);

                    // header 插在 pre 之前
                    wrapper.insertBefore(header, pre);
                });
            };

            const initPostEnhancements = async () => {
                await renderMermaidDiagrams();
                addMermaidZoomControls();
                addCopyButtons();
            };

            document.addEventListener("DOMContentLoaded", () => {
                void initPostEnhancements();
            });
            document.addEventListener("astro:page-load", () => {
                void initPostEnhancements();
            });
        </script>
    </body>
</html>
