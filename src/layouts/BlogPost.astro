---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/HeaderAndFooter/BaseHead.astro";
import Footer from "../components/HeaderAndFooter/Footer.astro";
import Header from "../components/HeaderAndFooter/Header.astro";
import ArticleContent from "../components/Blog/ArticleContent.astro";
import ArticleTocEnhancements from "../components/Blog/ArticleTocEnhancements.astro";
import CodeBlockEnhancements from "../components/Blog/CodeBlockEnhancements.astro";
import MermaidEnhancements from "../components/Blog/MermaidEnhancements.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import { getLocaleFromPath, type Locale } from "../lib/i18n";
import type { ReadingStats } from "../lib/readingStats";

interface PostNavigationItem {
    title: string;
    url: string;
}

type Props = CollectionEntry<"blog">["data"] & {
    headings?: MarkdownHeading[];
    readingStats?: ReadingStats;
    showReadingProgress?: boolean;
    locale?: Locale;
    alternateUrl?: string;
    previousPost?: PostNavigationItem;
    nextPost?: PostNavigationItem;
};

const {
    title,
    description,
    pubDate,
    updatedDate,
    heroImage,
    heroImageAlt = "",
    tags,
    headings = [],
    readingStats,
    showReadingProgress = true,
    reprintAuthor,
    locale = getLocaleFromPath(Astro.url.pathname),
    alternateUrl,
    previousPost,
    nextPost,
} = Astro.props;

const isEnglish = locale === "en";
---

<html lang={isEnglish ? "en" : "zh-CN"}>
    <head>
        <BaseHead
            title={title}
            description={description}
            image={heroImage}
            imageAlt={heroImageAlt}
            locale={locale}
            alternateUrl={alternateUrl}
            pageType="article"
            publishedTime={pubDate}
            modifiedTime={updatedDate}
            tags={tags}
            author={reprintAuthor}
        />
        <style>
            .site-wrapper {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }
        </style>
    </head>

    <body>
        {
            showReadingProgress && (
                <ReadingProgress
                    height={5}
                    showPercentage={true}
                />
            )
        }
        <div class="site-wrapper">
            <Header locale={locale} alternateUrl={alternateUrl} />
            <ArticleContent
                {...Astro.props}
                locale={locale}
                headings={headings}
                readingStats={readingStats}
                previousPost={previousPost}
                nextPost={nextPost}
            >
                <slot />
            </ArticleContent>
            <Footer locale={locale} />
        </div>
        <ArticleTocEnhancements />
        <MermaidEnhancements />
        <CodeBlockEnhancements />
    </body>
</html>
