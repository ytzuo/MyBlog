---
import SmartIcon from "./SmartIcon.astro";
import lost1 from "../assets/lost/lost1.png";
import lost2 from "../assets/lost/lost2.png";
import lost3 from "../assets/lost/lost3.png";
import lost4 from "../assets/lost/lost4.png";
import lost5 from "../assets/lost/lost5.png";

// 幽灵帧数组
const ghostFrames: ImageMetadata[] = [lost1, lost2, lost3, lost4, lost5];

// 如果没有提供图片的默认回退
const fallbackIcon = "👻";

interface Props {
    count?: number;
}

const { count = 6 } = Astro.props;
---

<div id="ghost-container" data-count={count}>
    <!-- 幽灵将由客户端脚本注入以实现随机性 -->
</div>

<!-- 单个幽灵的模板，用于克隆 -->
<template id="ghost-template">
    <div class="ghost-wrapper">
        <div class="ghost-float">
            <div class="ghost-inner">
                {
                    ghostFrames.length > 0 ? (
                        <SmartIcon
                            icon={ghostFrames}
                            duration={0.8}
                            size={54}
                        />
                    ) : (
                        <SmartIcon icon={fallbackIcon} size={54} />
                    )
                }
            </div>
        </div>
    </div>
</template>

<script>
    const MOBILE_BREAKPOINT = 720;
    const MOBILE_GHOST_SPACING = 900;
    const MIN_MOBILE_GHOSTS = 2;
    const MAX_MOBILE_GHOSTS = 12;

    let ghostLayoutObserver: ResizeObserver | null = null;
    let ghostRefreshTimer: number | undefined;

    interface GhostPosition {
        x: number;
        y: number;
    }

    const getFullPageHeight = (): number =>
        Math.max(
            window.innerHeight,
            document.documentElement.scrollHeight,
            document.documentElement.offsetHeight,
            document.body.scrollHeight,
            document.body.offsetHeight,
        );

    const getMobileGhostCount = (): number =>
        Math.min(
            MAX_MOBILE_GHOSTS,
            Math.max(
                MIN_MOBILE_GHOSTS,
                Math.ceil(getFullPageHeight() / MOBILE_GHOST_SPACING),
            ),
        );

    const initGhosts = () => {
        const container = document.getElementById("ghost-container");
        const template = document.getElementById(
            "ghost-template",
        ) as HTMLTemplateElement;

        if (container && template) {
            // Clear existing ghosts to prevent duplicates if function runs multiple times
            container.innerHTML = "";

            const isMobile = window.innerWidth <= MOBILE_BREAKPOINT;
            const preferredCount = Number(
                container.dataset.count || (isMobile ? "3" : "6"),
            );
            const ghostCount = isMobile
                ? getMobileGhostCount()
                : Math.max(
                      4,
                      Math.round(
                          preferredCount * (0.8 + Math.random() * 0.5),
                      ),
                  );
            const mainContentWidth = 1200; // 匹配 global.css 的主要宽度
            const windowWidth = window.innerWidth;
            const sideWidth = (windowWidth - mainContentWidth) / 2;
            const ghostWidth = 60;
            const safeOffset = 16;
            const verticalSpace = Math.max(
                0,
                container.clientHeight - ghostWidth - 20,
            );
            const minY = Math.min(100, verticalSpace);
            const minGhostDistance = isMobile ? 130 : 150;
            const maxPositionAttempts = 48;
            const placedPositions: GhostPosition[] = [];

            const getRandomX = (): number => {
                if (windowWidth <= mainContentWidth + 100) {
                    return (
                        Math.random() *
                        Math.max(40, windowWidth - ghostWidth)
                    );
                }

                const sideRange = Math.max(
                    24,
                    sideWidth - ghostWidth - safeOffset * 2,
                );
                const isLeft = Math.random() > 0.5;
                return isLeft
                    ? safeOffset + Math.random() * sideRange
                    : windowWidth -
                          sideWidth +
                          safeOffset +
                          Math.random() * sideRange;
            };

            const getRandomPosition = (): GhostPosition => ({
                x: getRandomX(),
                y: minY + Math.random() * (verticalSpace - minY),
            });

            const getSpacedPosition = (): GhostPosition => {
                let bestPosition: GhostPosition | null = null;
                let bestDistance = -1;

                for (
                    let attempt = 0;
                    attempt < maxPositionAttempts;
                    attempt++
                ) {
                    const candidate = getRandomPosition();
                    const closestDistance =
                        placedPositions.length === 0
                            ? Number.POSITIVE_INFINITY
                            : Math.min(
                                  ...placedPositions.map((position) =>
                                      Math.hypot(
                                          candidate.x - position.x,
                                          candidate.y - position.y,
                                      ),
                                  ),
                              );

                    if (closestDistance >= minGhostDistance) {
                        return candidate;
                    }

                    if (closestDistance > bestDistance) {
                        bestDistance = closestDistance;
                        bestPosition = candidate;
                    }
                }

                return bestPosition ?? getRandomPosition();
            };

            container.dataset.layoutMode = isMobile ? "mobile" : "desktop";
            container.dataset.renderedCount = String(ghostCount);
            container.dataset.pageHeight = String(getFullPageHeight());

            for (let i = 0; i < ghostCount; i++) {
                const clone = template.content.cloneNode(
                    true,
                ) as DocumentFragment;
                const wrapper = clone.querySelector(
                    ".ghost-wrapper",
                ) as HTMLElement;

                if (wrapper) {
                    const position = getSpacedPosition();
                    placedPositions.push(position);

                    // 设置初始位置
                    wrapper.style.left = `${position.x}px`;
                    wrapper.style.top = `${position.y}px`;

                    // 添加漂浮动画延迟以增加多样性
                    wrapper.style.animationDelay = `-${Math.random() * 5}s`;
                    wrapper.style.setProperty(
                        "--ghost-scale",
                        `${0.75 + Math.random() * 0.55}`,
                    );
                    wrapper.style.setProperty(
                        "--ghost-opacity",
                        `${0.45 + Math.random() * 0.3}`,
                    );

                    // 点击事件：飞走
                    if (!isMobile) {
                        wrapper.addEventListener("click", () => {
                            if (wrapper.classList.contains("flying")) {
                                return;
                            }

                            wrapper.classList.add("flying");

                            // 动画结束后移除
                            setTimeout(() => {
                                wrapper.remove();
                            }, 800); // 匹配 CSS 过渡持续时间
                        });
                    }

                    container.appendChild(wrapper);
                }
            }
        }
    };

    const GHOST_KEY = "ghost-effect-enabled";

    const scheduleGhostRefresh = () => {
        window.clearTimeout(ghostRefreshTimer);
        ghostRefreshTimer = window.setTimeout(() => {
            const container = document.getElementById("ghost-container");
            if (!container || container.style.display === "none") return;

            const isMobile = window.innerWidth <= MOBILE_BREAKPOINT;
            const nextMode = isMobile ? "mobile" : "desktop";
            const modeChanged = container.dataset.layoutMode !== nextMode;
            const countChanged =
                isMobile &&
                Number(container.dataset.renderedCount) !==
                    getMobileGhostCount();

            if (modeChanged || countChanged) {
                initGhosts();
            }
        }, 180);
    };

    const observeGhostLayout = () => {
        ghostLayoutObserver?.disconnect();

        const container = document.getElementById("ghost-container");
        const observedElement =
            container?.closest("main") ?? document.querySelector(".site-wrapper");
        if (!container || !observedElement) return;

        ghostLayoutObserver = new ResizeObserver(scheduleGhostRefresh);
        ghostLayoutObserver.observe(observedElement);
    };

    const maybeInitGhosts = () => {
        const container = document.getElementById("ghost-container");
        if (!container) return;

        if (localStorage.getItem(GHOST_KEY) === "false") {
            container.style.display = "none";
            ghostLayoutObserver?.disconnect();
            return;
        }
        container.style.display = "";
        initGhosts();
        observeGhostLayout();
    };

    // 初始加载和视图转换后运行
    document.addEventListener("astro:page-load", () => {
        requestAnimationFrame(() => {
            requestAnimationFrame(maybeInitGhosts);
        });
    });
    // 由幽灵开关按钮触发，用于动态重新初始化
    document.addEventListener("ghost:reinit", () => {
        initGhosts();
        observeGhostLayout();
    });
    document.addEventListener("astro:before-swap", () => {
        ghostLayoutObserver?.disconnect();
        ghostLayoutObserver = null;
        window.clearTimeout(ghostRefreshTimer);
    });
</script>

<style>
    #ghost-container {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100vw;
        height: 100%;
        pointer-events: none; /* 让点击穿过空白区域 */
        overflow: hidden;
        z-index: 50; /* 在普通内容之上，但在模态框/标题之下（如果需要） */
        -webkit-tap-highlight-color: transparent;
        user-select: none;
    }

    :global(.ghost-wrapper) {
        position: absolute;
        pointer-events: auto; /* 为幽灵重新启用点击 */
        cursor: pointer;
        transition:
            transform 1s ease-out,
            opacity 1s ease-out;
        /* 初始不透明度为 0 并淡入以避免突然出现 */
        opacity: 0;
        animation-fill-mode: forwards; /* 保持最终状态 */
        transform: scale(var(--ghost-scale, 1));
        -webkit-tap-highlight-color: transparent;
        -webkit-touch-callout: none;
        user-select: none;
    }

    /* 单独的淡入动画以处理初始加载 */
    :global(.ghost-wrapper) {
        animation: appear 1s ease-out forwards;
    }

    .ghost-float {
        animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-15px);
        }
    }

    @keyframes appear {
        from {
            opacity: 0;
        }
        to {
            opacity: var(--ghost-opacity, 0.72);
        } /* 幽灵稍微透明 */
    }

    /* 飞走状态 */
    :global(.ghost-wrapper.flying) {
        pointer-events: none;
        opacity: 0; /* 这里的 opacity 变化会触发 transition */
        transform: translateY(-100px) scale(0.9); /* transform 变化也会触发 transition */
    }

    .ghost-inner {
        /* 图标的内部容器 */
        filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
        transition: transform 0.2s;
        -webkit-tap-highlight-color: transparent;
        user-select: none;
    }

    :global(.ghost-wrapper .smart-icon),
    :global(.ghost-wrapper smart-icon-anim),
    :global(.ghost-wrapper .frame),
    :global(.ghost-wrapper img) {
        -webkit-tap-highlight-color: transparent;
        -webkit-touch-callout: none;
        user-select: none;
    }

    :global(.ghost-wrapper img) {
        -webkit-user-drag: none;
        user-drag: none;
        pointer-events: none;
    }

    :global(.ghost-wrapper:hover) .ghost-inner {
        transform: scale(1.1);
    }

    @media (max-width: 720px) {
        :global(.ghost-wrapper) {
            pointer-events: none;
            cursor: default;
        }
    }
</style>
