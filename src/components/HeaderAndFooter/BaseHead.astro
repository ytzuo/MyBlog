---
// 在此处导入 global.css 文件，以便通过 <BaseHead /> 组件将其包含在所有页面中。
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../../assets/blog-placeholder-1.jpg';
import {
    SITE_AUTHOR,
    SITE_AUTHOR_URL,
    SITE_DESCRIPTION,
    SITE_DESCRIPTION_EN,
    SITE_TITLE,
    SITE_TITLE_EN,
} from '../../consts';
import { getLocaleFromPath, localizePath, type Locale } from '../../lib/i18n';

type PageType = "website" | "article";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
    imageAlt?: string;
    locale?: Locale;
    alternateUrl?: string;
    pageType?: PageType;
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
    author?: string;
    noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
    title,
    description,
    image = FallbackImage,
    imageAlt,
    locale = getLocaleFromPath(Astro.url.pathname),
    alternateUrl,
    pageType = "website",
    publishedTime,
    modifiedTime,
    tags = [],
    author = SITE_AUTHOR,
    noindex = false,
} = Astro.props;
const otherLocale = locale === "en" ? "zh" : "en";
const alternatePath =
    alternateUrl ?? localizePath(Astro.url.pathname, otherLocale);
const alternateURL = new URL(alternatePath, Astro.site);
const defaultLocaleURL = locale === "en" ? alternateURL : canonicalURL;
const siteURL = new URL("/", Astro.site);
const siteTitle = locale === "en" ? SITE_TITLE_EN : SITE_TITLE;
const siteDescription = locale === "en" ? SITE_DESCRIPTION_EN : SITE_DESCRIPTION;
const languageTag = locale === "en" ? "en" : "zh-CN";
const ogLocale = locale === "en" ? "en_US" : "zh_CN";
const alternateOgLocale = locale === "en" ? "zh_CN" : "en_US";
const imageURL = new URL(image.src, canonicalURL);
const resolvedImageAlt = imageAlt ?? (pageType === "article" ? title : siteTitle);
const robotsContent = noindex
    ? "noindex, follow"
    : "index, follow, max-image-preview:large";

const toIsoDate = (value: string | undefined): string | undefined => {
    if (!value) return undefined;
    return value.length === 10
        ? `${value}T00:00:00.000Z`
        : new Date(value).toISOString();
};

const publishedTimeIso = toIsoDate(publishedTime);
const modifiedTimeIso = toIsoDate(modifiedTime) ?? publishedTimeIso;
const websiteId = new URL("/#website", Astro.site).href;
const authorId = new URL("/#author", Astro.site).href;
const webpageId = `${canonicalURL.href}#webpage`;
const imageObject = {
    "@type": "ImageObject",
    url: imageURL.href,
    width: image.width,
    height: image.height,
    caption: resolvedImageAlt,
};
const structuredDataGraph: Record<string, unknown>[] = [
    {
        "@type": "WebSite",
        "@id": websiteId,
        url: siteURL.href,
        name: siteTitle,
        description: siteDescription,
        inLanguage: languageTag,
        publisher: { "@id": authorId },
    },
    {
        "@type": "Person",
        "@id": authorId,
        name: SITE_AUTHOR,
        url: siteURL.href,
        sameAs: [SITE_AUTHOR_URL],
    },
    {
        "@type": "WebPage",
        "@id": webpageId,
        url: canonicalURL.href,
        name: title,
        description,
        inLanguage: languageTag,
        isPartOf: { "@id": websiteId },
        primaryImageOfPage: imageObject,
    },
];

if (pageType === "article" && publishedTimeIso) {
    structuredDataGraph.push({
        "@type": "BlogPosting",
        "@id": `${canonicalURL.href}#article`,
        mainEntityOfPage: { "@id": webpageId },
        headline: title,
        description,
        image: imageObject,
        datePublished: publishedTimeIso,
        dateModified: modifiedTimeIso,
        inLanguage: languageTag,
        author:
            author === SITE_AUTHOR
                ? { "@id": authorId }
                : { "@type": "Person", name: author },
        publisher: { "@id": authorId },
        keywords: tags,
        isAccessibleForFree: true,
    });
}

const structuredDataJson = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": structuredDataGraph,
}).replace(/</g, "\\u003c");
---

<!-- 全局元数据 -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/ghost-cat-code.svg" />
<!-- <link rel="icon" href="/favicon.ico" /> -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={locale === "en" ? SITE_TITLE_EN : SITE_TITLE}
	href={new URL(locale === "en" ? 'en/rss.xml' : 'rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={robotsContent} />
<meta name="author" content={author} />

<!-- View Transitions -->
<ClientRouter />

<script is:inline>
	(() => {
		const storageKey = 'theme-preference';
		const applyTheme = () => {
			const root = document.documentElement;
			const stored = localStorage.getItem(storageKey);
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const theme = stored === 'light' || stored === 'dark' ? stored : (prefersDark ? 'dark' : 'light');
			root.dataset.theme = theme;
			root.style.colorScheme = theme;
		};

		applyTheme();
	})();
</script>

<script>
	import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

	document.addEventListener('astro:before-swap', (event) => {
		const theme = document.documentElement.dataset.theme;
		if (theme !== 'light' && theme !== 'dark') return;

		const nextDocument = (event as TransitionBeforeSwapEvent).newDocument;
		nextDocument.documentElement.dataset.theme = theme;
		nextDocument.documentElement.style.colorScheme = theme;
	});
</script>

<!-- 字体预加载 -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- 规范 URL -->
<link rel="canonical" href={canonicalURL} />
<link
    rel="alternate"
    hreflang={locale === "en" ? "zh-CN" : "en"}
    href={alternateURL}
/>
<link
    rel="alternate"
    hreflang={locale === "en" ? "en" : "zh-CN"}
    href={canonicalURL}
/>
<link rel="alternate" hreflang="x-default" href={defaultLocaleURL} />

<!-- 主要元标签 -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pageType} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={alternateOgLocale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
<meta property="og:image:alt" content={resolvedImageAlt} />
{
    pageType === "article" && publishedTimeIso && (
        <>
            <meta property="article:published_time" content={publishedTimeIso} />
            <meta property="article:modified_time" content={modifiedTimeIso} />
            <meta property="article:author" content={author} />
            {tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
    )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />

<!-- 结构化数据 -->
<script is:inline type="application/ld+json" set:html={structuredDataJson} />
