---
// 在此处导入 global.css 文件，以便通过 <BaseHead /> 组件将其包含在所有页面中。
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../../assets/blog-placeholder-1.jpg';
import { SITE_TITLE, SITE_TITLE_EN } from '../../consts';
import { getLocaleFromPath, localizePath, type Locale } from '../../lib/i18n';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
    imageAlt?: string;
    locale?: Locale;
    alternateUrl?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
    title,
    description,
    image = FallbackImage,
    imageAlt,
    locale = getLocaleFromPath(Astro.url.pathname),
    alternateUrl,
} = Astro.props;
const otherLocale = locale === "en" ? "zh" : "en";
const alternatePath =
    alternateUrl ?? localizePath(Astro.url.pathname, otherLocale);
---

<!-- 全局元数据 -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/ghost-cat-code.svg" />
<!-- <link rel="icon" href="/favicon.ico" /> -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={locale === "en" ? SITE_TITLE_EN : SITE_TITLE}
	href={new URL(locale === "en" ? 'en/rss.xml' : 'rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- View Transitions -->
<ClientRouter />

<script is:inline>
	(() => {
		const storageKey = 'theme-preference';
		const applyTheme = () => {
			const root = document.documentElement;
			const stored = localStorage.getItem(storageKey);
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const theme = stored === 'light' || stored === 'dark' ? stored : (prefersDark ? 'dark' : 'light');
			root.dataset.theme = theme;
			root.style.colorScheme = theme;
		};

		applyTheme();
		document.addEventListener('astro:page-load', applyTheme);
	})();
</script>

<!-- 字体预加载 -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- 规范 URL -->
<link rel="canonical" href={canonicalURL} />
<link
    rel="alternate"
    hreflang={locale === "en" ? "zh-CN" : "en"}
    href={new URL(alternatePath, Astro.site)}
/>
<link
    rel="alternate"
    hreflang={locale === "en" ? "en" : "zh-CN"}
    href={canonicalURL}
/>
<link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />

<!-- 主要元标签 -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:locale" content={locale === "en" ? "en_US" : "zh_CN"} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />
{imageAlt && <meta property="twitter:image:alt" content={imageAlt} />}
