---
import { SITE_TITLE, SITE_TITLE_EN } from "../../consts";
import {
    getLocaleFromPath,
    localizePath,
    type Locale,
} from "../../lib/i18n";
import HeaderLink from "./HeaderLink.astro";
import SmartIcon from "../SmartIcon.astro";
import ghostFrame1 from "../../assets/lost/lost1.png";
import ghostFrame2 from "../../assets/lost/lost2.png";
import ghostFrame3 from "../../assets/lost/lost3.png";
import ghostFrame4 from "../../assets/lost/lost4.png";
import ghostFrame5 from "../../assets/lost/lost5.png";

const ghostFrames: ImageMetadata[] = [
    ghostFrame1,
    ghostFrame2,
    ghostFrame3,
    ghostFrame4,
    ghostFrame5,
];

interface Props {
    locale?: Locale;
    alternateUrl?: string;
}

const {
    locale = getLocaleFromPath(Astro.url.pathname),
    alternateUrl,
} = Astro.props;
const isEnglish = locale === "en";
const languageHref =
    alternateUrl ??
    (isEnglish
        ? localizePath(Astro.url.pathname, "zh")
        : localizePath(Astro.url.pathname, "en"));
---

<header>
    <nav>
        <h2>
            <a href={localizePath("/", locale)} class="site-logo">
                <img
                    src="/ghost-cat-code.svg"
                    alt="Blog Logo"
                    width="32"
                    height="32"
                />
                {isEnglish ? SITE_TITLE_EN : SITE_TITLE}
            </a>
        </h2>
        <div class="nav-right">
            <div class="internal-links">
                <HeaderLink href={localizePath("/", locale)}>
                    {isEnglish ? "Home" : "首页"}
                </HeaderLink>
                <HeaderLink href={localizePath("/blog", locale)}>
                    {isEnglish ? "Blog" : "博文"}
                </HeaderLink>
                <HeaderLink href={localizePath("/about", locale)}>
                    {isEnglish ? "About" : "关于我"}
                </HeaderLink>
            </div>
            <button
                id="ghost-toggle-btn"
                class="ghost-toggle-btn"
                type="button"
                aria-label={isEnglish ? "Toggle ghost effects" : "幽灵特效开关"}
                title={isEnglish ? "Ghost effects" : "幽灵特效"}
                data-enabled="true"
            >
                <SmartIcon icon={ghostFrames} duration={0.8} size={22} />
            </button>
            <button
                class="theme-toggle"
                type="button"
                aria-label={isEnglish ? "Switch to dark mode" : "切换黑夜模式"}
                title={isEnglish ? "Switch to dark mode" : "切换黑夜模式"}
                data-light-label={isEnglish ? "Switch to light mode" : "切换到浅色模式"}
                data-dark-label={isEnglish ? "Switch to dark mode" : "切换到黑夜模式"}
            >
                <span class="theme-toggle-track" aria-hidden="true">
                    <span class="theme-toggle-knob">
                        <span class="theme-toggle-sun">☀</span>
                        <span class="theme-toggle-moon">☾</span>
                    </span>
                </span>
            </button>
            <a
                class="language-toggle"
                href={languageHref}
                lang={isEnglish ? "zh-CN" : "en"}
                hreflang={isEnglish ? "zh-CN" : "en"}
                aria-label={isEnglish ? "切换到中文" : "Switch to English"}
                title={isEnglish ? "切换到中文" : "Switch to English"}
            >
                {isEnglish ? "中" : "EN"}
            </a>
            <div class="social-links">
                <a
                    href="https://github.com/ytzuo"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="sr-only">
                        {isEnglish ? "Visit my GitHub" : "访问我的 GitHub"}
                    </span>
                    <svg
                        viewBox="0 0 16 16"
                        aria-hidden="true"
                        width="32"
                        height="32"
                        astro-icon="social/github"
                    >
                        <path
                            fill="currentColor"
                            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                        >
                        </path>
                    </svg>
                </a>
            </div>
        </div>
    </nav>
</header>
<script>
    const initThemeToggle = () => {
        const root = document.documentElement;
        const toggle = document.querySelector(
            ".theme-toggle",
        ) as HTMLButtonElement | null;
        if (!toggle) return;

        if (toggle.dataset.ready === "true") {
            toggle.setAttribute(
                "aria-pressed",
                String(root.dataset.theme === "dark"),
            );
            return;
        }

        const storageKey = "theme-preference";
        const syncState = () => {
            const isDark = root.dataset.theme === "dark";
            toggle.setAttribute("aria-pressed", String(isDark));
            const label = isDark
                ? toggle.dataset.lightLabel
                : toggle.dataset.darkLabel;
            if (label) {
                toggle.setAttribute("title", label);
                toggle.setAttribute("aria-label", label);
            }
        };

        toggle.dataset.ready = "true";
        syncState();

        toggle.addEventListener("click", () => {
            const rect = toggle.getBoundingClientRect();
            const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                root.dataset.theme = nextTheme;
                root.style.colorScheme = nextTheme;
                localStorage.setItem(storageKey, nextTheme);
                syncState();
                return;
            }

            const overlay = document.createElement("div");
            overlay.className = `theme-transition-overlay theme-to-${nextTheme}`;
            overlay.innerHTML = '<div class="theme-transition-backdrop"></div>';
            overlay.style.setProperty(
                "--theme-origin-x",
                `${Math.max(rect.left + rect.width / 2, window.innerWidth - 80)}px`,
            );
            overlay.style.setProperty(
                "--theme-origin-y",
                `${Math.max(rect.top + rect.height / 2, window.innerHeight - 80)}px`,
            );
            document.body.appendChild(overlay);

            window.setTimeout(() => {
                root.dataset.theme = nextTheme;
                root.style.colorScheme = nextTheme;
                localStorage.setItem(storageKey, nextTheme);
                syncState();
            }, 240);

            overlay.addEventListener(
                "animationend",
                () => {
                    overlay.remove();
                },
                { once: true },
            );
        });
    };

    document.addEventListener("astro:page-load", initThemeToggle);

    // 幽灵特效开关（仅在首页有效）
    const initGhostToggle = () => {
        const GHOST_KEY = "ghost-effect-enabled";
        const btn = document.getElementById(
            "ghost-toggle-btn",
        ) as HTMLButtonElement | null;
        if (!btn) return;

        // 同步持久化状态到按钮外观
        const enabled = localStorage.getItem(GHOST_KEY) !== "false";
        btn.dataset.enabled = String(enabled);

        // 仅在存在幽灵容器的页面（首页）激活并显示按钮
        const container = document.getElementById(
            "ghost-container",
        ) as HTMLElement | null;
        if (!container) return;

        btn.style.display = "flex";

        btn.addEventListener("click", () => {
            const isEnabled = btn.dataset.enabled !== "false";
            const next = !isEnabled;
            btn.dataset.enabled = String(next);
            localStorage.setItem(GHOST_KEY, String(next));

            if (next) {
                container.style.display = "";
                document.dispatchEvent(new Event("ghost:reinit"));
            } else {
                container.style.display = "none";
                container.innerHTML = "";
            }
        });
    };

    document.addEventListener("astro:page-load", initGhostToggle);

    const syncHeaderStickyClearance = () => {
        const header = document.querySelector("header");
        if (!header) return;

        const headerHeight = Math.ceil(header.getBoundingClientRect().height);
        const clearance = headerHeight + 32;
        document.documentElement.style.setProperty(
            "--header-sticky-clearance",
            `${clearance}px`,
        );
    };

    let headerMetricsController: AbortController | null = null;
    let headerScrollFrame: number | null = null;

    const initHeaderStickyMetrics = () => {
        headerMetricsController?.abort();
        headerMetricsController = new AbortController();
        const { signal } = headerMetricsController;
        const header = document.querySelector("header");
        if (!header) return;

        const mobileQuery = window.matchMedia("(max-width: 720px)");
        let lastScrollY = Math.max(window.scrollY, 0);

        const showHeader = () => {
            header.classList.remove("is-scroll-hidden");
        };

        const updateHeaderVisibility = () => {
            headerScrollFrame = null;
            const currentScrollY = Math.max(window.scrollY, 0);

            if (!mobileQuery.matches || currentScrollY <= 24) {
                showHeader();
                lastScrollY = currentScrollY;
                return;
            }

            const scrollDelta = currentScrollY - lastScrollY;
            if (Math.abs(scrollDelta) < 8) return;

            if (
                scrollDelta > 0 &&
                currentScrollY > header.getBoundingClientRect().height + 24
            ) {
                header.classList.add("is-scroll-hidden");
            } else {
                showHeader();
            }
            lastScrollY = currentScrollY;
        };

        const scheduleHeaderVisibility = () => {
            headerScrollFrame ??= requestAnimationFrame(
                updateHeaderVisibility,
            );
        };

        showHeader();
        syncHeaderStickyClearance();
        window.addEventListener("resize", syncHeaderStickyClearance, {
            passive: true,
            signal,
        });
        window.addEventListener("resize", scheduleHeaderVisibility, {
            passive: true,
            signal,
        });
        window.addEventListener("scroll", scheduleHeaderVisibility, {
            passive: true,
            signal,
        });
        header.addEventListener("focusin", showHeader, { signal });
    };

    document.addEventListener("astro:page-load", initHeaderStickyMetrics);
    document.addEventListener("astro:before-swap", () => {
        headerMetricsController?.abort();
        headerMetricsController = null;
        if (headerScrollFrame !== null) {
            cancelAnimationFrame(headerScrollFrame);
            headerScrollFrame = null;
        }
    });
</script>
<style>
    header {
        margin: 0;
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 0;
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.96),
            rgba(252, 252, 252, 0.98)
        );
        border-bottom: 1px solid rgba(90, 90, 90, 0.12);
        box-shadow:
            0 -20vh 0 20vh rgba(255, 255, 255, 0.96),
            0 8px 18px rgba(35, 35, 35, 0.05);
        backdrop-filter: blur(12px);
        transition:
            transform 0.26s ease,
            box-shadow 0.2s ease;
    }
    h2 {
        margin: 0;
        font-size: 1em;
    }

    h2 a,
    h2 a.active {
        text-decoration: none;
    }
    .site-logo {
        display: flex;
        align-items: center;
        gap: 0.7em;
        font-weight: 700;
        letter-spacing: 0.02em;
    }
    .site-logo img {
        display: block;
        filter: drop-shadow(0 4px 6px rgba(84, 70, 39, 0.14));
    }
    nav {
        width: min(1120px, 100%);
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.05rem 1.15rem;
        box-sizing: border-box;
        border-radius: 0;
        background: transparent;
        border: 0;
        box-shadow: none;
        position: relative;
        overflow: visible;
    }
    nav::before {
        content: "";
        position: absolute;
        inset: 0;
        background: none;
        opacity: 0;
        pointer-events: none;
    }
    .nav-right {
        --header-control-height: 2.4rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        position: relative;
        z-index: 1;
        flex-shrink: 0;
    }
    .internal-links {
        display: flex;
        align-items: center;
        gap: 0.2rem;
        padding: 0;
        background: transparent;
    }
    nav a {
        padding: 0.7rem 1rem;
        color: rgb(var(--black));
        border-bottom: 0;
        text-decoration: none;
        border-radius: 10px;
        position: relative;
        transition:
            background 0.18s ease,
            color 0.18s ease;
        z-index: 1;
    }
    .internal-links a {
        padding: 0.58rem 0.82rem;
        border-radius: 6px;
    }
    .internal-links a::after {
        content: "";
        position: absolute;
        right: 0.82rem;
        bottom: 0.22rem;
        left: 0.82rem;
        height: 2px;
        border-radius: 999px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.18s ease;
    }
    .site-logo,
    h2 {
        position: relative;
        z-index: 1;
    }
    .internal-links a:hover {
        background: rgba(112, 87, 23, 0.06);
        color: var(--accent-dark);
    }
    .internal-links a.active {
        text-decoration: none;
        background: rgba(112, 87, 23, 0.08);
        box-shadow: none;
        color: var(--accent-dark);
    }
    .internal-links a.active::after {
        transform: scaleX(1);
    }
    .language-toggle,
    .social-links,
    .social-links a {
        display: flex;
    }
    .ghost-toggle-btn {
        display: none; /* 默认隐藏，JS 在首页显示 */
        align-items: center;
        justify-content: center;
        width: var(--header-control-height);
        height: var(--header-control-height);
        border-radius: 10px;
        border: 1px solid var(--theme-control-border);
        background: rgba(255, 255, 255, 0.55);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.85),
            0 5px 10px rgba(84, 70, 39, 0.08);
        cursor: pointer;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease,
            background 0.18s ease,
            opacity 0.2s ease,
            filter 0.2s ease;
    }
    .ghost-toggle-btn:hover {
        transform: translateY(-1px);
        background: rgba(255, 252, 246, 0.82);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.9),
            0 9px 16px rgba(84, 70, 39, 0.1);
    }
    .ghost-toggle-btn:active {
        transform: translateY(4px) scale(0.98);
        box-shadow:
            inset 0 6px 10px rgba(84, 70, 39, 0.18),
            inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }
    .ghost-toggle-btn[data-enabled="false"] {
        opacity: 0.45;
        filter: grayscale(0.9);
    }
    :global(html[data-theme="dark"]) .ghost-toggle-btn {
        background: var(--theme-control-bg);
        border-color: var(--theme-control-border);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.06),
            0 5px 10px rgba(0, 0, 0, 0.2);
    }
    :global(html[data-theme="dark"]) .ghost-toggle-btn:hover {
        background: rgba(34, 29, 24, 0.95);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.08),
            0 9px 16px rgba(0, 0, 0, 0.28);
    }
    .theme-toggle {
        width: 3.9rem;
        height: var(--header-control-height);
        flex: 0 0 auto;
        border: 1px solid var(--theme-control-border);
        border-radius: 10px;
        background: linear-gradient(
            180deg,
            rgba(255, 253, 248, 0.84),
            rgba(241, 235, 225, 0.96)
        );
        color: var(--theme-control-text);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.85),
            0 5px 10px rgba(84, 70, 39, 0.08);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        cursor: pointer;
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease,
            background 0.18s ease,
            color 0.18s ease;
        z-index: 1;
    }
    .theme-toggle:hover {
        transform: translateY(-1px);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.92),
            0 9px 16px rgba(84, 70, 39, 0.1);
    }
    .theme-toggle:active {
        transform: translateY(4px) scale(0.98);
        box-shadow:
            inset 0 6px 10px rgba(84, 70, 39, 0.18),
            inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }
    .theme-toggle-track {
        position: absolute;
        inset: 0.18rem;
        border-radius: 10px;
        background: linear-gradient(
            180deg,
            rgba(255, 252, 245, 0.94),
            rgba(226, 214, 193, 0.76)
        );
        box-shadow:
            inset 0 1px 2px rgba(255, 255, 255, 0.85),
            inset 0 -1px 2px rgba(84, 70, 39, 0.08);
        overflow: hidden;
    }
    .theme-toggle-track::before,
    .theme-toggle-track::after {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.76rem;
        line-height: 1;
        opacity: 0.55;
    }
    .theme-toggle-track::before {
        content: "☀";
        left: 0.48rem;
        color: #9b7525;
    }
    .theme-toggle-track::after {
        content: "☾";
        right: 0.52rem;
        color: #6f5ea3;
    }
    .theme-toggle-knob {
        position: absolute;
        top: 0.12rem;
        left: 0.14rem;
        width: 1.7rem;
        height: 1.7rem;
        border-radius: 999px;
        background: linear-gradient(180deg, #fffdf8 0%, #eadfca 100%);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.95),
            0 4px 10px rgba(84, 70, 39, 0.16);
        display: flex;
        align-items: center;
        justify-content: center;
        transition:
            transform 0.24s ease,
            background 0.24s ease,
            box-shadow 0.24s ease;
    }
    .theme-toggle-sun,
    .theme-toggle-moon {
        position: absolute;
        font-size: 0.95rem;
        line-height: 1;
        transition:
            transform 0.24s ease,
            opacity 0.24s ease;
    }
    .theme-toggle-sun {
        opacity: 1;
        transform: scale(1);
        color: #9b7525;
    }
    .theme-toggle-moon {
        opacity: 0;
        transform: scale(0.6);
        color: #efe7ff;
    }
    :global(html[data-theme="dark"]) .theme-toggle {
        background: linear-gradient(
            180deg,
            rgba(34, 29, 24, 0.96),
            rgba(14, 12, 10, 0.98)
        );
        border-color: var(--surface-border);
        color: rgb(var(--black));
    }
    :global(html[data-theme="dark"]) .theme-toggle-track {
        background: linear-gradient(
            180deg,
            rgba(31, 26, 21, 0.98),
            rgba(11, 9, 7, 0.96)
        );
        box-shadow:
            inset 0 1px 2px rgba(255, 255, 255, 0.06),
            inset 0 -1px 2px rgba(0, 0, 0, 0.18);
    }
    :global(html[data-theme="dark"]) .theme-toggle-knob {
        transform: translateX(1.52rem);
        background: linear-gradient(180deg, #4f5e7d 0%, #2f3a56 100%);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.12),
            0 4px 10px rgba(0, 0, 0, 0.28);
    }
    :global(html[data-theme="dark"]) .theme-toggle-sun {
        opacity: 0;
        transform: scale(0.6);
    }
    :global(html[data-theme="dark"]) .theme-toggle-moon {
        opacity: 1;
        transform: scale(1);
    }
    .language-toggle,
    .social-links a {
        align-items: center;
        justify-content: center;
        width: var(--header-control-height);
        height: var(--header-control-height);
        padding: 0;
        box-sizing: border-box;
        border: 1px solid var(--theme-control-border);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.55);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.85),
            0 5px 10px rgba(84, 70, 39, 0.08);
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease,
            background 0.18s ease;
        position: relative;
        z-index: 1;
    }
    .language-toggle {
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
    }
    .social-links a svg {
        width: 1.1rem;
        height: 1.1rem;
    }
    .language-toggle:hover,
    .social-links a:hover {
        transform: translateY(-1px);
        background: rgba(255, 252, 246, 0.82);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.9),
            0 9px 16px rgba(84, 70, 39, 0.1);
    }
    .language-toggle:active,
    .social-links a:active {
        transform: translateY(3px) scale(0.98);
        box-shadow:
            inset 0 5px 8px rgba(84, 70, 39, 0.16),
            inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }
    /* 暗黑模式：导航栏、内部链接、社交按钮 */
    :global(html[data-theme="dark"]) nav {
        background: transparent;
        border-color: transparent;
        box-shadow: none;
    }
    :global(html[data-theme="dark"]) header {
        background: linear-gradient(180deg, var(--surface-1), var(--surface-2));
        border-bottom-color: var(--surface-border);
        box-shadow:
            0 -20vh 0 20vh var(--surface-1),
            0 8px 18px rgba(0, 0, 0, 0.18);
    }
    :global(html[data-theme="dark"]) .internal-links {
        background: transparent;
        box-shadow: none;
    }
    :global(html[data-theme="dark"]) .internal-links a:hover {
        background: rgba(214, 183, 117, 0.08);
        box-shadow: none;
    }
    :global(html[data-theme="dark"]) .internal-links a.active {
        background: rgba(214, 183, 117, 0.1);
    }
    :global(html[data-theme="dark"]) .ghost-toggle-btn:hover,
    :global(html[data-theme="dark"]) .language-toggle:hover,
    :global(html[data-theme="dark"]) .social-links a:hover {
        background: rgba(70, 58, 45, 0.62);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.07),
            0 8px 14px rgba(0, 0, 0, 0.22);
    }
    :global(html[data-theme="dark"]) .theme-toggle:hover {
        background: linear-gradient(
            180deg,
            rgba(50, 42, 34, 0.96),
            rgba(28, 23, 18, 0.98)
        );
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.07),
            0 8px 14px rgba(0, 0, 0, 0.22);
    }
    :global(html[data-theme="dark"]) .language-toggle,
    :global(html[data-theme="dark"]) .social-links a {
        background: var(--theme-control-bg);
        border-color: var(--theme-control-border);
        color: rgb(var(--black));
    }
    @media (max-width: 720px) {
        header {
            top: 0;
            padding: 0;
        }
