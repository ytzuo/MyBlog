---
const today = new Date();
---

<footer>
    <div class="footer-shell">
        <div class="footer-meta">
            <span>&copy; {today.getFullYear()} Saten. All rights reserved.</span
            >
            <p>Powered by <a href="https://astro.build">Astro</a></p>
        </div>

        <div class="beian-info">
            <a
                href="https://beian.miit.gov.cn/"
                target="_blank"
                rel="noopener noreferrer"
            >
                闽ICP备2026003748号-1
            </a>
        </div>

        <div class="social-links">
            <a
                href="https://github.com/ytzuo/MyBlog"
                target="_blank"
                rel="noopener noreferrer"
                class="edit-link"
            >
                有意见？修改此页面
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
            </a>
        </div>
    </div>
</footer>

<style>
    footer {
        padding: 0;
        color: rgb(var(--gray));
        text-align: center;
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.94),
            rgba(250, 250, 250, 0.98)
        );
        border-top: 1px solid rgba(90, 90, 90, 0.12);
        box-shadow: 0 -8px 18px rgba(35, 35, 35, 0.04);
    }

    .footer-shell {
        width: min(1040px, calc(100% - 1.5rem));
        margin: 0 auto;
        padding: 0.9rem 1.25rem;
        box-sizing: border-box;
        border-radius: 0;
        background: transparent;
        border: 0;
        box-shadow: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        position: relative;
        overflow: hidden;
    }

    .footer-shell::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: var(--noise-texture);
        opacity: 0.08;
        pointer-events: none;
    }

    .footer-shell > * {
        position: relative;
        z-index: 1;
    }

    .footer-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.1rem;
        font-size: 0.9rem;
        text-align: left;
    }

    .footer-meta p {
        margin: 0;
        font-size: 0.85rem;
    }

    .beian-info {
        font-size: 0.84rem;
        color: rgb(var(--gray));
    }

    .beian-info a {
        color: rgb(var(--gray));
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .beian-info a:hover {
        color: rgb(var(--gray-dark));
        text-decoration: underline;
    }

    .social-links {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
    }

    .social-links a {
        text-decoration: none;
        color: rgb(var(--gray));
        transition:
            color 0.2s ease,
            transform 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 999px;
        background: rgba(255, 252, 246, 0.78);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.85),
            0 4px 8px rgba(84, 70, 39, 0.08);
    }

    .social-links a:hover {
        color: rgb(var(--gray-dark));
        transform: translateY(-1px);
    }

    .edit-link {
        width: auto !important;
        height: auto !important;
        padding: 0.4rem 0.85rem;
        border-radius: 8px !important;
        font-size: 0.85rem;
        gap: 0.35rem;
        white-space: nowrap;
    }

    .edit-link svg {
        flex-shrink: 0;
        margin-top: 1px;
    }

    /* 暗黑模式 */
    :global(html[data-theme="dark"]) .footer-shell {
        background: transparent;
        border-color: transparent;
        box-shadow: none;
    }
    :global(html[data-theme="dark"]) footer {
        background: linear-gradient(180deg, var(--surface-1), var(--surface-2));
        border-top-color: var(--surface-border);
        box-shadow: 0 -8px 18px rgba(0, 0, 0, 0.18);
    }
    :global(html[data-theme="dark"]) .social-links a {
        background: rgba(34, 29, 24, 0.9);
        color: rgb(var(--black));
    }

    @media (max-width: 720px) {
        .footer-shell {
            flex-direction: column;
            padding: 1rem;
            text-align: center;
        }

        .footer-meta {
            align-items: center;
            text-align: center;
        }
    }
</style>
