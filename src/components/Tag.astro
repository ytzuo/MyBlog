---
interface Props {
    tag: string;
    count?: number;
    class?: string;
}

const { tag, count, class: className } = Astro.props;
const showCount = count !== undefined;
---

<a href={`/tags/${tag}`} class:list={["tag", className]}>
    <span class="tag-label">{tag}</span>
    {showCount && <span class="tag-count">{count}</span>}
</a>

<style>
    .tag {
        background: linear-gradient(180deg, #fbfaf7 0%, #ece9e3 100%);
        padding: 0.4rem 1rem;
        border-radius: 8px; /* 柔和边缘 */
        font-size: 0.9rem;
        border: 1px solid rgba(92, 88, 80, 0.16);
        color: rgb(var(--black));
        text-decoration: none;
        transition:
            transform 0.12s ease,
            box-shadow 0.12s ease,
            background 0.12s ease,
            color 0.12s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        white-space: nowrap;
        cursor: pointer;
        /* 软橡胶按钮风格 */
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.9),
            0 6px 0 #c8c1b7,
            /* 3D 侧面 */ 0 9px 18px rgba(62, 58, 52, 0.1); /* 投影 */
        transform: translateY(0);
    }
    .tag-label {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .tag-count {
        min-width: 1.35em;
        padding: 0.05rem 0.35rem;
        border-radius: 999px;
        background: rgba(112, 87, 23, 0.12);
        color: var(--accent-dark);
        font-size: 0.78em;
        font-weight: 700;
        line-height: 1.35;
        text-align: center;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
    }
    .tag:hover {
        background: linear-gradient(180deg, #ffffff 0%, #f0ede7 100%);
        transform: translateY(3px) scale(0.992);
        box-shadow:
            0 3px 0 #c8c1b7,
            inset 0 3px 6px rgba(62, 58, 52, 0.07),
            inset 0 1px 0 rgba(255, 255, 255, 0.92),
            0 7px 12px rgba(62, 58, 52, 0.1);
        color: rgb(var(--black));
        border-color: rgba(92, 88, 80, 0.22);
    }
    /* 暗黑模式 */
    :global(html[data-theme="dark"]) .tag {
        background: linear-gradient(180deg, #343230 0%, #242220 100%);
        border-color: var(--surface-border);
        color: rgb(var(--black));
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.06),
            0 6px 0 #171514,
            0 10px 18px rgba(0, 0, 0, 0.24);
    }
    :global(html[data-theme="dark"]) .tag-count {
        background: rgba(212, 176, 103, 0.14);
        color: var(--accent);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .tag:active {
        /* 按下状态：内阴影反转 */
        transform: translateY(6px) scale(0.98);
        background: linear-gradient(180deg, #e6e2dc 0%, #d8d2c8 100%);
        box-shadow:
            0 0 0 rgba(205, 191, 168, 0),
            inset 0 6px 12px rgba(62, 58, 52, 0.16),
            inset 0 1px 1px rgba(255, 255, 255, 0.28); /* 模拟明显凹陷的内阴影 */
    }
</style>
