---
import { Image } from 'astro:assets';

interface Props {
	icon: string | ImageMetadata | ImageMetadata[];
	alt?: string;
	size?: number;
	/** 动画循环的时长（秒），仅对图片数组（帧动画）有效 */
	duration?: number;
}

const { icon, alt = "", size = 32, duration = 1 } = Astro.props;

const isImage = typeof icon === 'object' && icon !== null && !Array.isArray(icon);
const isAnimated = Array.isArray(icon);
const isImagePath =
	typeof icon === 'string' &&
	(/^(\/|https?:\/\/|data:image\/)/.test(icon) ||
		/\.(svg|png|jpe?g|webp|gif|avif)(\?.*)?$/i.test(icon));

// 辅助函数：将 icon 转换为数组以便进行 map 操作
const iconArray = isAnimated ? (icon as ImageMetadata[]) : [];
---

<div class="smart-icon" style={`--icon-size: ${size}px;`}>
	{
		isAnimated ? (
			<smart-icon-anim
				class="animated-icon-wrapper"
				style={`--frame-count: ${iconArray.length}; --animation-duration: ${duration}s;`}
				role={alt ? "img" : undefined}
				aria-label={alt || undefined}
				aria-hidden={alt ? undefined : "true"}
			>
				<div class="frame-strip">
					{iconArray.map((img) => (
						<div class="frame">
							<Image
								src={img}
								alt=""
								width={size * 2}
								height={size * 2}
								class="icon-img"
							/>
						</div>
					))}
				</div>
			</smart-icon-anim>
		) : isImage ? (
			<Image 
				src={icon as ImageMetadata} 
				alt={alt} 
				width={size * 2} 
				height={size * 2} 
				class="icon-img"
			/>
		) : isImagePath ? (
			<img
				src={icon as string}
				alt={alt}
				width={size * 2}
				height={size * 2}
				class="icon-img"
				loading="lazy"
			/>
		) : (
			<span class="icon-text">{icon}</span>
		)
	}
</div>

<style>
	.smart-icon {
		width: var(--icon-size);
		height: var(--icon-size);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: var(--icon-size);
		line-height: 1;
		position: relative;
	}

	.icon-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	.icon-text {
		display: block;
		line-height: 1;
	}

	/* 动画样式 */
	.animated-icon-wrapper {
		width: 100%;
		height: 100%;
		display: block;
		overflow: hidden;
	}

	.frame-strip {
		display: flex;
		width: calc(100% * var(--frame-count));
		height: 100%;
		animation: smart-icon-frames var(--animation-duration)
			steps(var(--frame-count), end) infinite;
	}

	.frame {
		flex: 0 0 calc(100% / var(--frame-count));
		height: 100%;
	}

	@keyframes smart-icon-frames {
		to {
			transform: translateX(-100%);
		}
	}
</style>
