---
import { Image } from "astro:assets";
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../FormattedDate.astro";
import Tag from "../Tag.astro";
import ReprintCard from "../ReprintCard.astro";
import type { Locale } from "../../lib/i18n";
import type { ReadingStats } from "../../lib/readingStats";

interface PostNavigationItem {
    title: string;
    url: string;
}

type Props = CollectionEntry<"blog">["data"] & {
    headings?: MarkdownHeading[];
    readingStats?: ReadingStats;
    locale: Locale;
    previousPost?: PostNavigationItem;
    nextPost?: PostNavigationItem;
};

const {
    title,
    pubDate,
    updatedDate,
    heroImage,
    heroImageAlt = "",
    heroImageScale = 1,
    tags,
    headings = [],
    readingStats,
    reprintAuthor,
    reprintUrl,
    reprintTitle,
    locale,
    previousPost,
    nextPost,
} = Astro.props;

const isEnglish = locale === "en";
const tocHeadings = headings.filter(
    (heading) => heading.depth === 2 || heading.depth === 3,
);
const hasToc = tocHeadings.length > 0;
---

<main>
    <!-- 顶部大图 -->
    <div class="hero-image">
        {
            heroImage && (
                <Image
                    width={1020}
                    src={heroImage}
                    alt={heroImageAlt}
                    style={`width: ${heroImageScale * 100}%; height: auto;`}
                />
            )
        }
    </div>
    <br />
    <div class="prose">
        <div class="title">
            <h1>{title}</h1>
            <div class="date">
                <span class="date-item">
                    <FormattedDate date={pubDate} locale={locale} />
                </span>
                {
                    readingStats && (
                        <>
                            <span class="date-item">
                                {readingStats.wordCountText}
                            </span>
                            <span class="date-item">
                                {readingStats.readingTimeText}
                            </span>
                        </>
                    )
                }
                {
                    updatedDate && (
                        <div class="last-updated-on">
                            {isEnglish
                                ? "Last updated on "
                                : "最后更新于 "}
                            <FormattedDate
                                date={updatedDate}
                                locale={locale}
                            />
                        </div>
                    )
                }
            </div>
            <!-- 标签展示 -->
            {
                tags && tags.length > 0 && (
                    <div class="tags">
                        {tags.map((tag) => (
                            <Tag tag={tag} locale={locale} />
                        ))}
                    </div>
                )
            }
            <hr />
        </div>
        <!-- 转载声明卡片 -->
        {
            reprintAuthor && reprintUrl && (
                <ReprintCard
                    author={reprintAuthor}
                    url={reprintUrl}
                    title={reprintTitle}
                    locale={locale}
                />
            )
        }
        <div class:list={["article-shell", { "has-toc": hasToc }]}>
            <article class="article-content">
                <!-- 文章内容插槽 -->
                <div class="article-body">
                    <slot />
                </div>
                {
                    (previousPost || nextPost) && (
                        <nav
                            class="post-navigation"
                            aria-label={
                                isEnglish
                                    ? "Post navigation"
                                    : "文章导航"
                            }
                        >
                            {previousPost && (
                                <a
                                    class="post-navigation-link previous"
                                    href={previousPost.url}
                                    rel="prev"
                                >
                                    <span class="post-navigation-label">
                                        {isEnglish
                                            ? "← Previous post"
                                            : "← 上一篇"}
                                    </span>
                                    <span class="post-navigation-title">
                                        {previousPost.title}
                                    </span>
                                </a>
                            )}
                            {nextPost && (
                                <a
                                    class="post-navigation-link next"
                                    href={nextPost.url}
                                    rel="next"
                                >
                                    <span class="post-navigation-label">
                                        {isEnglish
                                            ? "Next post →"
                                            : "下一篇 →"}
                                    </span>
                                    <span class="post-navigation-title">
                                        {nextPost.title}
                                    </span>
                                </a>
                            )}
                        </nav>
                    )
                }
            </article>
            {
                hasToc && (
                    <aside
                        class="toc-panel"
                        aria-label={
                            isEnglish
                                ? "Table of contents"
                                : "文章目录"
                        }
                    >
                        <details open>
                            <summary>
                                <span class="toc-title">
                                    {isEnglish
                                        ? "Table of contents"
                                        : "文章目录"}
                                </span>
                            </summary>
                            <nav class="toc-list">
                                {tocHeadings.map((heading) => (
                                    <a
                                        class:list={[
                                            "toc-link",
                                            `depth-${heading.depth}`,
                                        ]}
                                        href={`#${heading.slug}`}
                                        data-toc-link
                                        data-heading-id={heading.slug}
                                    >
                                        {heading.text}
                                    </a>
                                ))}
                            </nav>
                        </details>
                    </aside>
                )
            }
        </div>
    </div>
</main>

<style>
    main {
        width: min(1280px, calc(100% - 2rem));
        max-width: 100%;
        margin: 0 auto;
        flex: 1;
        box-sizing: border-box;
    }
    .hero-image {
        width: 100%;
    }
    .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 10px;
        box-shadow: var(--box-shadow);
        height: auto;
        max-width: 100%;
    }
    .prose {
        width: min(1100px, 100%);
        margin: 0 auto;
        padding: 0;
        color: rgb(var(--gray-dark));
        box-sizing: border-box;
    }
    .title {
        margin-bottom: 0.5em;
        padding: 0.1em 0;
        text-align: center;
        line-height: 1;
    }
    .title h1 {
        margin: 0 0 0.5em 0;
        font-size: 1.9em;
    }
    /* 正文内各级标题缩小 */
    .prose :global(h1) {
        font-size: 1.7em;
    }
    .prose :global(h2) {
        font-size: 1.45em;
    }
    .prose :global(h3) {
        font-size: 1.2em;
    }
    .prose :global(h4) {
        font-size: 1.05em;
    }
    .prose :global(h5) {
        font-size: 0.95em;
    }
    .prose :global(h6) {
        font-size: 0.875em;
    }
    .prose :global(h2),
    .prose :global(h3),
    .prose :global(h4),
    .prose :global(h5),
    .prose :global(h6) {
        scroll-margin-top: var(--header-sticky-clearance, 6rem);
    }
    .date {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.35rem 0.65rem;
        margin-bottom: 0.1em;
        color: rgb(var(--gray));
    }
    .date-item:not(:last-child)::after {
        content: "·";
        margin-left: 0.65rem;
        color: rgba(var(--gray), 0.75);
    }
    .last-updated-on {
        flex-basis: 100%;
        font-style: italic;
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5em;
        margin-top: 1em;
    }
    /* 中文正文段落自动首行缩进 */
    .article-body :global(p) {
        text-indent: 2em;
        margin-bottom: 1em;
        line-height: 1.8;
    }
    /* 英文正文不缩进，并用更大的段间距分隔段落 */
    :global(html[lang="en"]) .article-body :global(p) {
        text-indent: 0;
    }
    :global(html[lang="en"]) .article-body > :global(p) {
        margin-bottom: 1.35em;
    }
    /* 引用块内不缩进 */
    .article-body :global(blockquote p) {
        text-indent: 0;
    }
    /* 列表内不缩进 */
    .article-body :global(li p) {
        text-indent: 0;
    }
    /* 图片：block 居中，等比缩小，不拉伸 */
    .prose :global(img) {
        display: block;
        max-width: 100%;
        width: auto;
        height: auto;
        margin: 1.5rem auto;
    }
    /* 包含图片的段落取消首行缩进和文字居中影响 */
    .prose :global(p:has(> img)) {
        text-indent: 0;
        text-align: center;
        margin: 0;
    }

    .article-shell {
        display: block;
    }

    .article-shell.has-toc {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 17rem;
        gap: 1.65rem;
        align-items: start;
    }

    .article-content {
        min-width: 0;
        container-type: inline-size;
    }

    .article-body {
        width: min(76ch, 100%);
        margin-inline: auto;
    }

    .post-navigation {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--surface-border);
    }

    .post-navigation-link {
        display: flex;
        min-width: 0;
        min-height: 5.5rem;
        flex-direction: column;
        gap: 0.45rem;
        justify-content: center;
        padding: 1rem 1.1rem;
        border: 1px solid var(--surface-border);
        border-radius: 9px;
        background: linear-gradient(
            180deg,
            var(--surface-1),
            var(--surface-2)
        );
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.62),
            0 6px 16px var(--surface-shadow);
        color: rgb(var(--black));
        text-decoration: none;
        transition:
            border-color 0.18s ease,
            box-shadow 0.18s ease,
            transform 0.18s ease;
    }

    .post-navigation-link.next {
        grid-column: 2;
        text-align: right;
    }

    .post-navigation-link:hover {
        border-color: color-mix(
            in srgb,
            var(--accent) 45%,
            var(--surface-border)
        );
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.68),
            0 9px 20px var(--surface-shadow);
        transform: translateY(-2px);
    }

    .post-navigation-label {
        color: var(--accent);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .post-navigation-title {
        overflow-wrap: anywhere;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .toc-panel {
        position: sticky;
        top: var(--header-sticky-clearance, 6rem);
        max-height: calc(100vh - var(--header-sticky-clearance, 6rem) - 1rem);
        overflow: auto;
        padding: 1rem 1.05rem;
        border-radius: 8px;
        border: 1px solid var(--surface-border);
        background: linear-gradient(180deg, var(--surface-1), var(--surface-2));
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.62),
            0 8px 18px var(--surface-shadow);
    }

    .toc-panel summary {
        list-style: none;
        cursor: default;
        color: rgb(var(--black));
        font-size: 1.05rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .toc-panel summary::-webkit-details-marker {
        display: none;
    }

    .toc-title {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .toc-title::before {
        content: "";
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: var(--accent);
        box-shadow: 0 0 0 4px rgba(112, 87, 23, 0.1);
    }

    .toc-list {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: 0.9rem;
    }

    .toc-link {
        display: block;
        border-radius: 6px;
        padding: 0.42rem 0.5rem;
        color: rgb(var(--gray-dark));
        font-size: 0.94rem;
        line-height: 1.35;
        text-decoration: none;
        transition:
            background 0.18s ease,
            color 0.18s ease,
            transform 0.18s ease;
    }

    .toc-link.depth-3 {
        padding-left: 1.25rem;
        font-size: 0.87rem;
        color: rgb(var(--gray));
    }

    .toc-link:hover,
    .toc-link.is-active {
        background: rgba(112, 87, 23, 0.1);
        color: var(--accent-dark);
        transform: translateX(2px);
    }

    /* --- 代码块样式优化 --- */
    :global(.code-container) {
        position: relative;
        margin: 1.5rem 0;
        max-width: 100%;
        border-radius: 8px;
        border: 1px solid var(--gray-light, #e5e7eb);
        overflow: hidden;
    }

    /* 代码块顶部 header：语言标签 + 复制按钮 */
    :global(.code-header) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem 0.35rem 1rem;
        background: #1c1c1c;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        user-select: none;
    }

    :global(.code-lang) {
        font-family:
            Consolas, Monaco, "Andale Mono", "Ubuntu Mono", monospace;
        font-size: 0.72rem;
        font-weight: 600;
        color: rgba(120, 210, 160, 0.85);
        letter-spacing: 0.06em;
        text-transform: lowercase;
        line-height: 1;
    }

    .prose :global(pre) {
        padding: 0;
        border-radius: 0;
        margin: 0;
        border: none;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;
    }

    .prose :global(pre)::before,
    .prose :global(pre)::after {
        display: none;
    }

    .prose :global(code) {
        font-family:
            Consolas, Monaco, "Andale Mono", "Ubuntu Mono", monospace;
        font-size: 0.85em; /* 减小字体大小 */
        line-height: 1.5;
    }

    .prose :global(pre > code) {
        display: block;
        width: max-content;
        min-width: 100%;
        box-sizing: border-box;
        padding: 1rem;
        background:
            radial-gradient(
                circle,
                rgba(18, 16, 16, 0) 0%,
                rgba(0, 0, 0, 0.3) 100%
            ),
            linear-gradient(
                rgba(18, 16, 16, 0) 50%,
                rgba(0, 0, 0, 0.25) 50%
            ),
            linear-gradient(
                90deg,
                rgba(255, 0, 0, 0.06),
                rgba(0, 255, 0, 0.02),
                rgba(0, 0, 255, 0.06)
            ),
            #2c2c2c;
        background-size:
            auto,
            100% 2px,
            3px 100%,
            auto;
        background-repeat: no-repeat, repeat, repeat, no-repeat;
    }

    :global(html[data-theme="dark"]) .prose :global(pre > code) {
        background:
            radial-gradient(
                circle,
                rgba(18, 16, 16, 0) 0%,
                rgba(0, 0, 0, 0.36) 100%
            ),
            linear-gradient(
                rgba(18, 16, 16, 0) 50%,
                rgba(0, 0, 0, 0.28) 50%
            ),
            linear-gradient(
                90deg,
                rgba(255, 0, 0, 0.04),
                rgba(0, 255, 0, 0.025),
                rgba(0, 0, 255, 0.04)
            ),
            #212b23;
        background-size:
            auto,
            100% 2px,
            3px 100%,
            auto;
        background-repeat: no-repeat, repeat, repeat, no-repeat;
    }

    /* 内联代码样式 */
    .prose :global(p code),
    .prose :global(li code) {
        background-color: color-mix(
            in srgb,
            var(--accent) 12%,
            transparent
        );
        color: var(--accent);
        padding: 0.2em 0.4em;
        border-radius: 4px;
        font-size: 0.9em;
    }

    /* 复制按钮样式（位于 code-header 内，非绝对定位） */
    :global(.copy-code-btn) {
        flex-shrink: 0;
        background-color: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 4px;
        color: #c0c0c0;
        font-size: 0.72rem;
        padding: 0.18rem 0.55rem;
        cursor: pointer;
        transition:
            background-color 0.15s,
            color 0.15s,
            border-color 0.15s;
        line-height: 1.6;
        white-space: nowrap;
    }

    :global(.copy-code-btn:hover) {
        background-color: rgba(255, 255, 255, 0.16);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.28);
    }

    :global(.copy-code-btn.copied) {
        background-color: var(--accent);
        border-color: var(--accent);
        color: #fff;
    }

    :global(.mermaid-container) {
        position: relative;
        margin: 1.5rem 0;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid rgba(126, 103, 64, 0.12);
        background: linear-gradient(180deg, #fffdf8, #f8f4ec);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.86),
            0 4px 12px rgba(84, 70, 39, 0.05);
        overflow-x: auto;
    }

    :global(html[data-theme="dark"] .mermaid-container) {
        background: linear-gradient(180deg, #2b241d, #1f1a15);
        border-color: rgba(214, 183, 117, 0.18);
        box-shadow:
            inset 0 1px 0 rgba(255, 244, 219, 0.06),
            0 4px 12px rgba(0, 0, 0, 0.24);
    }

    :global(.mermaid-chart svg) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 0 auto;
    }

    /* Override prose paragraph indentation inside Mermaid labels */
    .prose :global(.mermaid-chart .label p),
    .prose :global(.mermaid-chart .nodeLabel p),
    .prose :global(.mermaid-chart foreignObject p) {
        margin: 0;
        text-indent: 0;
        text-align: center;
        line-height: 1.35;
    }

    :global(.mermaid-chart .edgePath .path),
    :global(.mermaid-chart .flowchart-link) {
        stroke: #000;
        stroke-width: 3.6px;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    :global(.mermaid-chart marker path) {
        fill: #000;
        stroke: #000;
        stroke-width: 2.4px;
    }

    :global(.mermaid-chart.mermaid-error) {
        color: #c0392b;
        font-size: 0.95rem;
        white-space: pre-wrap;
    }

    :global(.mermaid-zoom-btn) {
        display: none;
    }

    :global(.mermaid-zoom-modal) {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: none;
        flex-direction: column;
        background: rgba(18, 16, 14, 0.92);
        color: #fff;
        overscroll-behavior: none;
        touch-action: none;
    }

    :global(.mermaid-zoom-modal[data-open="true"]) {
        display: flex;
    }

    :global(.mermaid-zoom-toolbar) {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
        padding: 0.75rem;
        background: rgba(0, 0, 0, 0.28);
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        touch-action: manipulation;
    }

    :global(.mermaid-zoom-action) {
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        font: inherit;
        line-height: 1;
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    :global(.mermaid-zoom-viewport) {
        flex: 1;
        overflow: hidden;
        touch-action: none;
        position: relative;
    }

    :global(.mermaid-zoom-content) {
        position: absolute;
        top: 50%;
        left: 50%;
        transform-origin: 0 0;
        will-change: transform;
    }

    :global(.mermaid-zoom-content svg) {
        display: block;
        max-width: none;
        height: auto;
        background: #fffdf8;
        border-radius: 8px;
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
    }

    @media (max-width: 720px) {
        :global(.code-container) {
            width: auto;
            max-width: 100%;
            margin: 1.25rem 0;
            box-sizing: border-box;
            border-radius: 8px;
        }

        :global(.code-header) {
            border-radius: 8px 8px 0 0;
        }

        .prose :global(pre code) {
            font-size: 0.8rem;
            padding: 0.9rem 0.9rem 0.9rem 1rem;
        }

        :global(.mermaid-container) {
            padding: 0.9rem;
        }

        :global(.mermaid-zoom-btn) {
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            width: 2rem;
            height: 2rem;
            border: 1px solid rgba(126, 103, 64, 0.18);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.82);
            color: rgb(var(--black));
            box-shadow: 0 4px 12px rgba(84, 70, 39, 0.14);
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        :global(.mermaid-zoom-btn svg) {
            width: 1rem;
            height: 1rem;
        }

        :global(html[data-theme="dark"]) :global(.mermaid-zoom-btn) {
            background: rgba(43, 36, 29, 0.9);
            border-color: rgba(214, 183, 117, 0.18);
            color: rgb(var(--black));
        }
        .title h1 {
            font-size: 1.5em;
        }
        .prose :global(h1) {
            font-size: 1.4em;
        }
        .prose :global(h2) {
            font-size: 1.25em;
        }
        .prose :global(h3) {
            font-size: 1.1em;
        }
        .prose :global(h4) {
            font-size: 1em;
        }
        .prose :global(h5) {
            font-size: 0.9em;
        }
        .prose :global(h6) {
            font-size: 0.85em;
        }
    }

    @media (max-width: 980px) {
        .article-shell.has-toc {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .toc-panel {
            position: static;
            order: -1;
            width: 100%;
            max-height: none;
            box-sizing: border-box;
        }

        .toc-panel summary {
            cursor: pointer;
        }

        .toc-panel summary::after {
            content: "▾";
            float: right;
            color: var(--accent);
            font-size: 0.8rem;
            transition: transform 0.2s ease;
        }

        .toc-panel details:not([open]) summary::after {
            transform: rotate(-90deg);
        }
    }

    /* --- 电子表格样式 --- */
    .prose :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 2rem 0;
