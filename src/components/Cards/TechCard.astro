---
import Card from './Card.astro';
import SmartIcon from '../SmartIcon.astro';

interface Props {
	name: string;
	icon: string | ImageMetadata;
}

const { name, icon } = Astro.props;
---

<Card class="tech-card">
	<div class="icon-wrapper">
		<SmartIcon icon={icon} alt={name} size={70} />
	</div>
	<span class="name">{name}</span>
</Card>

	<script>
		const initTechCards = () => {
			const cards = document.querySelectorAll('.tech-card') as NodeListOf<HTMLElement>;
			const reduceMotion = window.matchMedia(
				'(prefers-reduced-motion: reduce)',
			).matches;

			cards.forEach(card => {
				if (card.dataset.techCardReady === 'true') {
					return;
				}
				card.dataset.techCardReady = 'true';

				if (reduceMotion) return;

				let animationFrame: number | null = null;
				let latestEvent: MouseEvent | null = null;
				let cardRect: DOMRect | null = null;

				const updateCardTransform = () => {
					animationFrame = null;
					if (!latestEvent || !cardRect) return;

					const x = latestEvent.clientX - cardRect.left;
					const y = latestEvent.clientY - cardRect.top;
					const centerX = cardRect.width / 2;
					const centerY = cardRect.height / 2;
					const pctX = (x - centerX) / centerX;
					const pctY = (y - centerY) / centerY;
					const rotateY = pctX * 18;
					const rotateX = -pctY * 16;
					const driftX = pctX * 8;
					const driftY = pctY * 8;
					const glowX = (x / cardRect.width) * 100;
					const glowY = (y / cardRect.height) * 100;

					card.style.setProperty('--pointer-x', `${glowX}%`);
					card.style.setProperty('--pointer-y', `${glowY}%`);
					card.style.transform =
						`perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translate3d(${driftX}px, ${driftY}px, 0) scale(1.03)`;
					card.style.boxShadow =
						`${-driftX * 1.4}px ${18 + Math.abs(driftY)}px 30px rgba(84, 70, 39, 0.18),
						${-driftX * 2.4}px ${28 + Math.abs(driftY)}px 52px rgba(84, 70, 39, 0.14),
						inset 0 1px 0 rgba(255, 255, 255, 0.92)`;
				};

				card.addEventListener('mouseenter', () => {
					cardRect = card.getBoundingClientRect();
					card.classList.add('is-interacting');
					card.style.transition = 'transform 0.12s ease-out, box-shadow 0.22s ease-out';
				});

				card.addEventListener('mousemove', (e) => {
					latestEvent = e;
					animationFrame ??= requestAnimationFrame(updateCardTransform);
				});

				card.addEventListener('mouseleave', () => {
					if (animationFrame !== null) {
						cancelAnimationFrame(animationFrame);
						animationFrame = null;
					}
					latestEvent = null;
					cardRect = null;
					card.classList.remove('is-interacting');
					card.style.transition = 'transform 0.5s ease, box-shadow 0.35s ease';
					card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translate3d(0, 0, 0) scale(1)';
					card.style.boxShadow = '';
					card.style.setProperty('--pointer-x', '50%');
					card.style.setProperty('--pointer-y', '50%');
				});
			});
		};

	document.addEventListener('astro:page-load', initTechCards);
</script>

<style>
		:global(.tech-card) {
			padding: 0.5rem !important;
			display: flex;
			flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		text-align: center;
		height: 100%;
			min-height: 140px;
			min-width: 120px;
			cursor: default;
			transform-style: preserve-3d;
			perspective: 1000px;
			--pointer-x: 50%;
			--pointer-y: 50%;
		}

		:global(.tech-card.is-interacting) {
			will-change: transform, box-shadow;
		}

		:global(.tech-card)::after {
			content: "";
			position: absolute;
			inset: 0;
			border-radius: inherit;
			background:
				radial-gradient(circle at var(--pointer-x) var(--pointer-y), rgba(255, 255, 255, 0.42), transparent 34%);
			opacity: 0.9;
			pointer-events: none;
			z-index: 1;
			transition: background-position 0.12s ease-out;
		}

		:global(html[data-theme='dark'] .tech-card::after) {
			background: none;
			opacity: 0;
		}

		.icon-wrapper {
			display: flex;
			align-items: center;
			justify-content: center;
			margin-bottom: 0rem;
			transform: translateY(0.35rem) translateZ(46px);
			filter: drop-shadow(0 10px 12px rgba(84, 70, 39, 0.12));
			transition: filter 0.2s ease;
		}

		:global(html[data-theme='dark']) .icon-wrapper {
			filter:
				drop-shadow(0 0 6px rgba(255, 255, 255, 0.14))
				drop-shadow(0 7px 12px rgba(255, 255, 255, 0.06));
		}

		.name {
			font-size: 1.2rem;
			font-weight: 500;
			color: var(--gray-dark);
			transform: translateZ(24px);
			text-shadow: 0 1px 0 rgba(255, 255, 255, 0.28);
		}
	</style>
