---
interface Props {
    class?: string;
    hoverEffect?: boolean;
}

const { class: className, hoverEffect = false, ...props } = Astro.props;
---

<div
    class:list={["card", className, { "hover-effect": hoverEffect }]}
    {...props}
>
    <slot />
</div>

<style>
    :global(.card) {
        background: #ffffff;
        border-radius: 12px;
        padding: 1.5rem;
        box-sizing: border-box;
        max-width: 100%;
        /* 磨砂陶瓷/纸张风格：增强阴影以获得更好的分离感 */
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.55),
            0 6px 14px rgba(97, 82, 51, 0.07),
            0 12px 24px rgba(97, 82, 51, 0.05),
            0 0 0 1px rgba(0, 0, 0, 0.025); /* 微妙的边框定义 */
        position: relative;
        overflow: hidden;
        transition:
            transform 0.24s ease,
            box-shadow 0.24s ease,
            border-color 0.24s ease;
    }

    /* 应用噪点纹理叠加 */
    :global(.card)::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: var(--noise-texture);
        opacity: 0.07;
        pointer-events: none;
        z-index: 1;
    }

    .card > :global(*) {
        position: relative;
        z-index: 2;
    }

    /* 暗黑模式 */
    :global(html[data-theme="dark"] .card) {
        background: linear-gradient(180deg, var(--surface-1), var(--surface-2));
        border-color: var(--surface-border);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.035),
            0 8px 18px rgba(0, 0, 0, 0.18);
    }

    .hover-effect:hover {
        transform: translateY(-7px) scale(1.01);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.72),
            0 14px 24px rgba(97, 82, 51, 0.11),
            0 24px 42px rgba(97, 82, 51, 0.08),
            0 0 0 1px rgba(112, 87, 23, 0.05);
    }
</style>
