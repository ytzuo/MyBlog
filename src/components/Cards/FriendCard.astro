---
import Card from "./Card.astro";
import { Image } from "astro:assets";
import type { FriendLink } from "../../data/friends";

interface Props {
    friend: FriendLink;
}

const { friend } = Astro.props;
const hostname = new URL(friend.url).hostname.replace(/^www\./, "");
const initials = friend.name.trim().slice(0, 2).toUpperCase();
---

<Card class="friend-card" hoverEffect>
    <a
        class="friend-card-link"
        href={friend.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`访问 ${friend.name}`}
    >
        <div class="friend-avatar" aria-hidden="true">
            {
                friend.avatar ? (
                    <Image src={friend.avatar} alt="" width={108} height={108} />
                ) : (
                    <span>{initials}</span>
                )
            }
        </div>

        <div class="friend-content">
            <div class="friend-heading">
                <h3><strong>{friend.name}</strong>{friend.titleSuffix}</h3>
                <span class="friend-domain">{hostname}</span>
            </div>

            <p>{friend.description}</p>
        </div>

    </a>
</Card>

<style>
    :global(.friend-card) {
        padding: 0 !important;
        min-height: 116px;
        border: 1px solid rgba(126, 103, 64, 0.08);
    }

    .friend-card-link {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: 0.85rem;
        height: 100%;
        padding: 0.9rem 1rem;
        color: inherit;
        text-decoration: none;
        box-sizing: border-box;
    }

    .friend-avatar {
        width: 3.4rem;
        height: 3.4rem;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        overflow: hidden;
        background:
            linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(236, 230, 218, 0.72)),
            var(--noise-texture);
        border: 1px solid rgba(126, 103, 64, 0.16);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.82),
            0 8px 16px rgba(84, 70, 39, 0.1);
    }

    .friend-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .friend-avatar span {
        color: var(--accent-dark);
        font-size: 1.05rem;
        font-weight: 800;
        line-height: 1;
    }

    .friend-content {
        min-width: 0;
    }

    .friend-heading {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.45rem 0.7rem;
        margin-bottom: 0.3rem;
    }

    .friend-heading h3 {
        margin: 0;
        color: rgb(var(--black));
        font-size: 1.08rem;
        font-weight: 500;
        line-height: 1.2;
        overflow-wrap: anywhere;
    }

    .friend-heading h3 strong {
        font-weight: 800;
    }

    .friend-domain {
        color: rgb(var(--gray));
        font-size: 0.8rem;
        line-height: 1.2;
        overflow-wrap: anywhere;
    }

    .friend-content p {
        margin: 0;
        color: rgb(var(--gray-dark));
        font-size: 0.88rem;
        line-height: 1.45;
    }

    :global(html[data-theme="dark"] .friend-card) {
        border-color: var(--surface-border);
    }

    :global(html[data-theme="dark"]) .friend-avatar {
        background:
            linear-gradient(135deg, rgba(68, 60, 48, 0.95), rgba(43, 40, 35, 0.96)),
            var(--noise-texture);
        border-color: rgba(214, 183, 117, 0.16);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.06),
            0 8px 16px rgba(0, 0, 0, 0.22);
    }

    @media (max-width: 620px) {
        .friend-card-link {
            grid-template-columns: auto minmax(0, 1fr);
            gap: 0.8rem;
            padding: 0.9rem;
        }
    }

    @media (max-width: 420px) {
        .friend-card-link {
            gap: 0.65rem;
            padding: 0.75rem;
        }

        .friend-avatar {
            width: 3rem;
            height: 3rem;
        }

    }
</style>
