---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import FormattedDate from "../FormattedDate.astro";
import Tag from "../Tag.astro";
import Card from "./Card.astro";
import { getReadingStats } from "../../lib/readingStats";

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const readingStats = getReadingStats(post.body ?? "");
const heroImage = post.data.heroImage;
const heroAspectRatio = heroImage
    ? heroImage.width / heroImage.height
    : 1;
const heroOrientation =
    heroAspectRatio < 0.9
        ? "portrait"
        : heroAspectRatio > 1.15
          ? "landscape"
          : "square";
---

<Card class="post-card" hoverEffect={true} data-post-url={`/blog/${post.id}/`}>
    {
        heroImage && (
            <a
                href={`/blog/${post.id}/`}
                class:list={[
                    "image-link",
                    `image-link--${heroOrientation}`,
                ]}
            >
                <Image width={440} src={heroImage} alt="" />
            </a>
        )
    }
    <div class="post-content">
        <!-- 文章标题 -->
        <h3 class="post-title">
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </h3>
        <!-- 文章元数据：日期 -->
        <div class="post-meta">
            <span><FormattedDate date={new Date(post.data.pubDate)} /></span>
            <span>{readingStats.wordCountText}</span>
            <span>{readingStats.readingTimeText}</span>
        </div>
        <!-- 文章描述 -->
        {
            post.data.description && (
                <p class="post-description">{post.data.description}</p>
            )
        }
        <!-- 标签列表 -->
        {
            post.data.tags && post.data.tags.length > 0 && (
                <div class="tag-container">
                    {post.data.tags.map((tag) => (
                        <Tag tag={tag} />
                    ))}
                </div>
            )
        }
    </div>
</Card>

<script>
    function initPostCardClick() {
        document.querySelectorAll<HTMLElement>(".post-card").forEach((card) => {
            card.addEventListener("click", (e) => {
                const target = e.target as HTMLElement;
                // 如果点击的是链接或其子元素，让默认行为执行
                if (target.closest("a")) return;
                const url = card.dataset.postUrl;
                if (url) {
                    window.location.href = url;
                }
            });
        });
    }
    document.addEventListener("astro:page-load", initPostCardClick);
</script>

<style>
    :global(.post-card) {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 2rem;
        padding: 2rem;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
    }

    /* 根据原图方向调整桌面端缩略图宽度，保持完整显示 */
    .image-link {
        flex-shrink: 0;
        align-self: center;
        width: 170px;
        height: auto;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: transparent;
    }

    .image-link--landscape {
        width: 220px;
    }

    .image-link--portrait {
        width: 140px;
    }

    :global(.post-card) img {
        width: 100%;
        height: auto;
        max-height: 210px;
        object-fit: contain;
        display: block;
    }

    .post-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .post-title {
        margin: 0 0 0.5rem 0;
        font-size: 1.4rem;
        line-height: 1.2;
    }

    .post-title a {
        color: rgb(var(--black));
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .post-title a:hover {
        color: var(--accent);
    }

    .post-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.65rem;
        align-items: center;
        color: rgb(var(--gray));
        font-size: 0.9rem;
        margin-bottom: 0.8rem;
    }

    .post-meta span:not(:last-child)::after {
        content: "·";
        margin-left: 0.65rem;
        color: rgba(var(--gray), 0.75);
    }

    .post-description {
        margin: 0 0 1rem 0;
        color: rgb(var(--gray-dark));
    }

    .tag-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    @media (max-width: 720px) {
        :global(.card.post-card) {
            flex-direction: column;
            gap: 1rem;
            width: calc(100% + 2rem);
            max-width: calc(100% + 2rem);
            margin-left: -1rem;
            margin-right: -1rem;
            padding: 1.25rem;
        }

        /* 移动端横向铺满，并按图片自身比例自然撑开高度 */
        .image-link {
            width: 100%;
            height: auto;
            aspect-ratio: auto;
            background-color: transparent;
        }

        :global(.post-card) img {
            width: 100%;
            height: auto;
            max-height: none;
            object-fit: contain;
        }
    }
</style>
