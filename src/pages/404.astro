---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
    SITE_TITLE,
    SITE_DESCRIPTION,
    SITE_TITLE_EN,
    SITE_DESCRIPTION_EN,
} from "../consts";
import Card from "../components/Cards/Card.astro";
import { getLocaleFromPath, type Locale } from "../lib/i18n";

interface Props {
    locale?: Locale;
}

const { locale = getLocaleFromPath(Astro.url.pathname) } = Astro.props;
const isEnglish = locale === "en";
---

<BaseLayout
    title={`404: ${isEnglish ? "Page not found" : "页面未找到"} - ${
        isEnglish ? SITE_TITLE_EN : SITE_TITLE
    }`}
    description={isEnglish ? SITE_DESCRIPTION_EN : SITE_DESCRIPTION}
    locale={locale}
    noindex
>
    <div class="center-wrapper">
        <Card class="error-container">
            <img src="/ghost-cat-code.svg" alt="404 Ghost" class="ghost-img" />
            <h1 class="error-code">404</h1>
            <p class="error-message">
                {
                    isEnglish
                        ? "You seem to be lost. This page went exploring and has not returned."
                        : "哎呀！你似乎迷路了，这个页面去探险还没回来。"
                }
            </p>
            <a href={isEnglish ? "/en/" : "/"} class="home-button">
                {isEnglish ? "Take me home" : "带我回主页"}
            </a>
            <p class="back-hint">
                {
                    isEnglish
                        ? "You can also use the navigation above to explore other posts."
                        : "或者你可以点击上方的导航链接去看看别的博文。"
                }
            </p>
        </Card>
    </div>
</BaseLayout>

<style>
    .center-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
    }

    .error-container {
        max-width: 600px;
        width: 100%;
        text-align: center;
    }

    .error-code {
        font-size: 8rem;
        font-weight: 800;
        margin: 0;
        line-height: 1;
        background: linear-gradient(
            135deg,
            var(--accent) 0%,
            var(--accent-dark) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
    }

    .error-message {
        font-size: 1.5rem;
        color: rgb(var(--gray-dark));
        margin: 1rem 0 2rem;
    }

    .ghost-img {
        width: 150px;
        height: 150px;
        margin-bottom: 2rem;
        animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }

    .home-button {
        display: inline-block;
        padding: 0.8rem 2rem;
        background: linear-gradient(180deg, #856726 0%, #6d5317 100%);
        color: white;
        text-decoration: none;
        border-radius: 30px;
        font-weight: bold;
        transition:
            transform 0.14s ease,
            box-shadow 0.14s ease,
            background 0.14s ease;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.22),
            0 7px 0 #4f3b10,
            0 12px 22px rgba(79, 68, 14, 0.28);
    }

    .home-button:hover {
        transform: translateY(3px) scale(0.992);
        box-shadow:
            0 4px 0 #4f3b10,
            inset 0 3px 6px rgba(44, 33, 9, 0.12),
            inset 0 1px 0 rgba(255, 255, 255, 0.28),
            0 10px 16px rgba(79, 68, 14, 0.28);
        background: linear-gradient(180deg, #927129 0%, #755919 100%);
        color: white;
    }

    .home-button:active {
        transform: translateY(7px) scale(0.98);
        box-shadow:
            0 0 0 rgba(79, 59, 16, 0),
            inset 0 7px 12px rgba(44, 33, 9, 0.28),
            inset 0 1px 1px rgba(255, 255, 255, 0.16);
    }

    /* 暗黑模式 */
    :global(html[data-theme="dark"]) .home-button {
        background: linear-gradient(180deg, #b28b48 0%, #8a682e 100%);
        color: #fff6e6;
    }

    .back-hint {
        margin-top: 1.5rem;
        font-size: 0.9rem;
        color: rgb(var(--gray));
    }
</style>
