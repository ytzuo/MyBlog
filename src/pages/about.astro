---
import htmlIcon from '../assets/techIcon/html.png';
import cssIcon from '../assets/techIcon/css.png';
import jsIcon from '../assets/techIcon/JavaScript.png';
import tsIcon from '../assets/techIcon/typescript.png';
import reactIcon from '../assets/techIcon/React.png';
import vueIcon from '../assets/techIcon/Vue.png';
import astroIcon from '../assets/techIcon/astro.png';
import javaIcon from '../assets/techIcon/java.png';
import kotlinIcon from '../assets/techIcon/kotlin.png';
import springBootIcon from '../assets/techIcon/SpringBoot.png';
import nodeIcon from '../assets/techIcon/Nodejs.png';
import goIcon from '../assets/techIcon/go-original-wordmark.svg?url';
import cppIcon from '../assets/techIcon/cplusplus.png';
import cSharpIcon from '../assets/techIcon/csharp.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import TechCard from '../components/Cards/TechCard.astro';
import GhostSprites from '../components/GhostSprites.astro';
import { SITE_TITLE } from '../consts';

// 定义兴趣列表数据
// 包含分类和具体的项目（名称和图标）
const interests = [
	{
		category: "前端技术",
		items: [
			{ name: "HTML", icon: htmlIcon },
			{ name: "CSS", icon: cssIcon },
			{ name: "JavaScript", icon: jsIcon },
			{ name: "TypeScript", icon: tsIcon },
			{ name: "React", icon: reactIcon },
			{ name: "Vue", icon: vueIcon },
			{ name: "Astro", icon: astroIcon },
		]
	},
	{
		category: "后端技术",
		items: [
			{ name:"Java",icon: javaIcon },
			{ name:"kotlin",icon: kotlinIcon },
			{ name: "Go", icon: goIcon },
			{ name: "C/C++", icon: cppIcon },
			{ name: "C#", icon: cSharpIcon },
			{ name:"Spring Boot",icon: springBootIcon },
			{ name: "Node.js", icon: nodeIcon },
		]
	},
	{
		category: "游戏",
		items: [
			{ name: "RPG", icon: "⚔️" },
			{ name: "FPS", icon: "🔫" },
			{ name: "RougeLike", icon: "🎮" },
		]
	},
	{
		category: "其他",
		items: [
			{ name: "Music", icon: "🎵" },
			{ name: "Reading", icon: "📚" },
			{ name: "Movies", icon: "🎬" },
		]
	}
];
---

<BaseLayout title={`关于我 - ${SITE_TITLE}`} description="关于我自己">
	<GhostSprites />

	<section class="about-page">
		<header class="about-hero">
			<h1>关于我</h1>
			<div class="about-intro">
				<div>软件工程大三在读，喜欢打打游戏听听歌。</div>
				<div>全方位探索中，如果有想分享的东西，就在这里拿出来给大家看看。</div>
			</div>
		</header>

		<section class="interests-section" aria-labelledby="interests-title">
			<h2 id="interests-title" class="section-title">本站可能包含</h2>

			<div class="interests-grid">
				{interests.map((section) => (
					<div class="interest-section">
						<h3 class="category-title">{section.category}</h3>
						<div class="card-grid">
							{section.items.map((item) => (
								<TechCard name={item.name} icon={item.icon} />
							))}
						</div>
					</div>
				))}
			</div>
		</section>
	</section>

	<style>
		.about-page {
			width: min(100%, 1120px);
			margin: 0 auto;
		}

		.about-hero {
			margin-bottom: clamp(2.5rem, 7vw, 4.5rem);
			text-align: center;
		}

		.about-hero h1 {
			margin-bottom: 1rem;
			font-size: clamp(2rem, 8vw, 3rem);
			line-height: 1.1;
		}

		.about-intro {
			width: min(100%, calc(100vw - 2rem));
			margin: 0 auto;
			box-sizing: border-box;
			text-align: center;
			line-height: 1.7;
			font-size: clamp(1rem, 3vw, 1.18rem);
			color: rgb(var(--gray-dark));
		}

		.about-intro div {
			text-align: center;
			white-space: nowrap;
		}

		.interests-section {
			margin-top: 0;
		}

		.section-title {
			margin: 0 0 1.5rem;
			font-size: clamp(1.35rem, 4vw, 1.75rem);
			text-align: left;
		}

		.interests-grid {
			display: flex;
			flex-direction: column;
			gap: 4rem;
		}

		.category-title {
			margin-bottom: 1rem;
			font-size: 1.2rem;
			color: rgb(var(--gray-dark));
			border-left: 4px solid var(--accent);
			padding-left: 0.8rem;
		}

		.card-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
			gap: 1.6rem 1.5rem;
		}

		@media (max-width: 600px) {
			.about-intro {
				width: min(100%, calc(100vw - 2.5rem));
			}

			.about-intro div {
				white-space: normal;
			}

			.card-grid {
				grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
			}
		}
	</style>
</BaseLayout>
