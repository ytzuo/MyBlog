---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPostUrl, isEnglishPost } from '../../lib/i18n';
import {
	assertUniquePostSlugs,
	assertValidTranslationPairs,
	getPostNavigation,
	isVisiblePost,
} from '../../lib/posts';
import { getReadingStats } from '../../lib/readingStats';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	assertValidTranslationPairs(allPosts);
	const posts = allPosts.filter(
		(post) => isVisiblePost(post) && !isEnglishPost(post),
	);
	assertUniquePostSlugs(posts, 'Chinese');
	return posts.map((post) => ({
		params: { slug: post.data.slug },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const readingStats = getReadingStats(post.body ?? "");
const allPosts = await getCollection("blog");
const englishTranslation = allPosts.find(
	(candidate) =>
		isVisiblePost(candidate) &&
		isEnglishPost(candidate) &&
		candidate.data.translationKey === post.data.translationKey,
);
const { previousPost, nextPost } = getPostNavigation(
	allPosts.filter(
		(candidate) => isVisiblePost(candidate) && !isEnglishPost(candidate),
	),
	post,
);
const alternateUrl = englishTranslation
	? getPostUrl(englishTranslation)
	: "/en/blog/";
---

<BlogPost
	{...post.data}
	headings={headings}
	readingStats={readingStats}
	locale="zh"
	alternateUrl={alternateUrl}
	previousPost={previousPost && {
		title: previousPost.data.title,
		url: getPostUrl(previousPost),
	}}
	nextPost={nextPost && {
		title: nextPost.data.title,
		url: getPostUrl(nextPost),
	}}
>
	<Content />
</BlogPost>
