---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/Cards/PostList.astro";
import {
    SITE_DESCRIPTION,
    SITE_TITLE,
    SITE_DESCRIPTION_EN,
    SITE_TITLE_EN,
} from "../../consts";
import GhostSprites from "../../components/GhostSprites.astro";
import { isEnglishPost, type Locale } from "../../lib/i18n";
import { isVisiblePost } from "../../lib/posts";

interface Props {
    locale?: Locale;
}
const { locale = "zh" } = Astro.props;
const isEnglish = locale === "en";
const posts = (await getCollection("blog"))
    .filter(
        (post) =>
            isVisiblePost(post) &&
            isEnglishPost(post) === isEnglish,
    )
    .sort(
    (a, b) =>
        new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
    );

---

<BaseLayout
    title={isEnglish ? SITE_TITLE_EN : SITE_TITLE}
    description={isEnglish ? SITE_DESCRIPTION_EN : SITE_DESCRIPTION}
    locale={locale}
>
    <GhostSprites />
    <div class="blog-header">
        <h2 class="blog-title">{isEnglish ? "All posts" : "所有博客"}</h2>
        <div class="blog-actions">
            <a class="blog-action-btn search-link" href={isEnglish ? "/en/search" : "/search"}>
                <span class="btn-text">{isEnglish ? "Search" : "搜索文章"}</span>
            </a>
            <a class="blog-action-btn" href={isEnglish ? "/en/tags" : "/tags"}>
                <span class="btn-text">{isEnglish ? "All tags" : "全部标签"}</span>
            </a>
        </div>
    </div>

    <section>
        <PostList posts={posts} centered>
            <div slot="empty" class="empty-state">
                <div class="empty-icon">📝</div>
                <h3>{isEnglish ? "No posts yet" : "暂无博客文章"}</h3>
                <p>
                    {isEnglish
                        ? "New writing is on the way."
                        : "博主正在努力创作中，敬请期待……"}
                </p>
            </div>
        </PostList>
    </section>
</BaseLayout>

<style>
    .blog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: clamp(0.75rem, 4vw, 1.5rem);
        margin-bottom: 2rem;
        position: relative;
    }
    .blog-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex: 0 0 auto;
    }
    .blog-action-btn {
        background: linear-gradient(
            180deg,
            rgba(251, 250, 247, 0.92),
            rgba(236, 233, 227, 0.97)
        );
        border: 1px solid rgba(92, 88, 80, 0.16);
        padding: clamp(0.4rem, 1.8vw, 0.5rem) clamp(0.85rem, 4vw, 1.5rem);
        border-radius: 20px;
        cursor: pointer;
        font-size: clamp(0.82rem, 3.4vw, 1rem);
        color: rgb(var(--black));
        display: flex;
        align-items: center;
        gap: clamp(0.25rem, 1.6vw, 0.5rem);
        transition:
            transform 0.14s ease,
            box-shadow 0.14s ease,
            background 0.14s ease;
        font-weight: bold;
        line-height: 1;
        white-space: nowrap;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.9),
            0 6px 0 #c8c1b7,
            0 10px 18px rgba(62, 58, 52, 0.09);
    }
    .blog-action-btn {
        text-decoration: none;
    }
    .search-link {
        border-radius: 18px;
    }
    .blog-action-btn:hover {
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.98),
            rgba(241, 238, 232, 0.98)
        );
        border-color: rgba(92, 88, 80, 0.24);
        transform: translateY(3px) scale(0.992);
        box-shadow:
            0 3px 0 #c8c1b7,
            inset 0 3px 6px rgba(62, 58, 52, 0.07),
            inset 0 1px 0 rgba(255, 255, 255, 0.96),
            0 8px 14px rgba(62, 58, 52, 0.11);
    }
    .blog-action-btn:active {
        transform: translateY(6px) scale(0.98);
        box-shadow:
            0 0 0 rgba(205, 191, 168, 0),
            inset 0 6px 12px rgba(62, 58, 52, 0.16),
            inset 0 1px 1px rgba(255, 255, 255, 0.3);
    }
    .section-title {
        font-size: 1.5rem;
        color: rgb(var(--black));
        margin-bottom: 1rem;
        text-align: center;
        width: 100%;
        font-weight: 700;
    }
    .blog-title {
        flex: 1 1 auto;
        min-width: 0;
        font-size: clamp(1.35rem, 7vw, 2rem);
        font-weight: 800;
        margin: 0;
        color: rgb(var(--black));
        text-align: left;
        line-height: 1.2;
        white-space: nowrap;
    }
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 16px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        margin-top: 2rem;
    }
    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        animation: float 3s ease-in-out infinite;
    }
    .empty-state h3 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        color: rgb(var(--black));
    }
    .empty-state p {
        color: rgb(var(--gray));
    }
    /* 暗黑模式 */
    :global(html[data-theme="dark"]) .empty-state {
        background: linear-gradient(180deg, var(--surface-1), var(--surface-2));
        border-color: var(--surface-border);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.05),
            0 10px 24px var(--surface-shadow);
    }
    :global(html[data-theme="dark"]) .blog-action-btn {
        background: linear-gradient(180deg, #343230 0%, #242220 100%);
        border-color: var(--surface-border);
        color: rgb(var(--black));
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.06),
            0 6px 0 #171514,
            0 10px 18px rgba(0, 0, 0, 0.24);
    }
    :global(html[data-theme="dark"]) .blog-action-btn:hover {
        background: linear-gradient(180deg, #3d3a36 0%, #292624 100%);
    }

    @media (max-width: 560px) {
        .blog-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .blog-actions {
            width: auto;
            justify-content: flex-start;
            flex-wrap: wrap;
            gap: 0.6rem;
        }

        .blog-action-btn,
        .search-link {
            padding: 0.38rem 0.95rem;
            border-radius: 8px;
            background: linear-gradient(180deg, #fbfaf7 0%, #ece9e3 100%);
            font-size: 0.9rem;
            font-weight: 700;
            line-height: 1.2;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.9),
                0 5px 0 #c8c1b7,
                0 9px 16px rgba(62, 58, 52, 0.12);
        }

        .blog-action-btn:hover {
            background: linear-gradient(180deg, #ffffff 0%, #f0ede7 100%);
            transform: translateY(2px);
            box-shadow:
                0 3px 0 #c8c1b7,
                inset 0 1px 0 rgba(255, 255, 255, 0.92),
                0 7px 12px rgba(62, 58, 52, 0.1);
        }

        .blog-action-btn:active {
            transform: translateY(5px) scale(0.98);
            box-shadow:
                inset 0 3px 6px rgba(62, 58, 52, 0.14),
                inset 0 1px 1px rgba(255, 255, 255, 0.28);
        }

        :global(html[data-theme="dark"]) .blog-action-btn {
            background: linear-gradient(180deg, #343230 0%, #242220 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.05),
                0 5px 0 #171514,
                0 9px 16px rgba(0, 0, 0, 0.26);
        }

        :global(html[data-theme="dark"]) .blog-action-btn:hover {
            background: linear-gradient(180deg, #3d3a36 0%, #292624 100%);
            box-shadow:
                0 3px 0 #171514,
                inset 0 1px 0 rgba(255, 255, 255, 0.06),
                0 7px 12px rgba(0, 0, 0, 0.22);
        }
    }
</style>
