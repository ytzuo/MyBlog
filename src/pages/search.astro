---
import BaseLayout from "../layouts/BaseLayout.astro";
import GhostSprites from "../components/GhostSprites.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<BaseLayout title={`站内搜索 - ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
    <GhostSprites />
    <section class="search-page">
        <div class="search-hero">
            <h1>站内搜索</h1>
            <form id="search-form" class="search-form" role="search">
                <label class="sr-only" for="site-search-input">搜索文章</label>
                <div class="search-input-shell">
                    <span class="search-icon" aria-hidden="true">⌕</span>
                    <input
                        id="site-search-input"
                        type="search"
                        name="q"
                        autocomplete="off"
                        placeholder="搜索标题、标签、摘要或正文..."
                    />
                    <button class="tag search-submit-btn" type="submit">
                        <span class="tag-label">搜索</span>
                    </button>
                </div>
            </form>
        </div>

        <div id="search-status" class="search-status" aria-live="polite">
            输入关键词开始搜索。
        </div>
        <div id="search-results" class="search-results"></div>
    </section>
</BaseLayout>

<script>
    interface SearchIndexItem {
        title: string;
        description: string;
        url: string;
        pubDate: string;
        tags: string[];
        content: string;
    }

    interface SearchResult extends SearchIndexItem {
        score: number;
        snippet: string;
    }

    let searchIndexPromise: Promise<SearchIndexItem[]> | null = null;

    const normalize = (value: string): string => value.toLocaleLowerCase();

    const escapeHtml = (value: string): string =>
        value
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");

    const escapeRegExp = (value: string): string =>
        value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

    const getSearchIndex = async (): Promise<SearchIndexItem[]> => {
        if (!searchIndexPromise) {
            searchIndexPromise = fetch("/search-index.json").then((res) => {
                if (!res.ok) {
                    throw new Error("Search index failed to load.");
                }
                return res.json() as Promise<SearchIndexItem[]>;
            });
        }
        return searchIndexPromise;
    };

    const getTerms = (query: string): string[] =>
        normalize(query).split(/\s+/).filter(Boolean);

    const scorePost = (post: SearchIndexItem, terms: string[]): number => {
        const title = normalize(post.title);
        const description = normalize(post.description);
        const content = normalize(post.content);
        const tags = post.tags.map(normalize);

        let score = 0;
        for (const term of terms) {
            let termScore = 0;
            if (title.includes(term)) termScore += 16;
            if (description.includes(term)) termScore += 7;
            if (content.includes(term)) termScore += 2;
            if (tags.some((tag) => tag === term)) termScore += 14;
            if (tags.some((tag) => tag.includes(term))) termScore += 8;
            if (termScore === 0) return 0;
            score += termScore;
        }

        return score;
    };

    const createSnippet = (
        post: SearchIndexItem,
        terms: string[],
    ): string => {
        const source = post.content || post.description;
        const normalizedSource = normalize(source);
        const firstMatch = terms
            .map((term) => normalizedSource.indexOf(term))
            .filter((index) => index >= 0)
            .sort((a, b) => a - b)[0];
        const start =
            firstMatch === undefined ? 0 : Math.max(0, firstMatch - 56);
        const end = Math.min(source.length, start + 150);
        const prefix = start > 0 ? "..." : "";
        const suffix = end < source.length ? "..." : "";
        return `${prefix}${source.slice(start, end)}${suffix}`;
    };

    const highlight = (value: string, terms: string[]): string => {
        const escaped = escapeHtml(value);
        const uniqueTerms = [...new Set(terms)]
            .filter((term) => term.length > 0)
            .sort((a, b) => b.length - a.length);

        if (uniqueTerms.length === 0) return escaped;

        const pattern = new RegExp(
            `(${uniqueTerms.map(escapeRegExp).join("|")})`,
            "gi",
        );
        return escaped.replace(pattern, "<mark>$1</mark>");
    };

    const formatDate = (value: string): string => {
        const date = new Date(value);
        if (Number.isNaN(date.valueOf())) return value;
        return date.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "long",
            day: "numeric",
        });
    };

    const renderResults = (
        resultsContainer: HTMLElement,
        status: HTMLElement,
        results: SearchResult[],
        query: string,
        terms: string[],
    ) => {
        if (query.trim().length === 0) {
            status.textContent = "输入关键词开始搜索。";
            resultsContainer.innerHTML = "";
            return;
        }

        if (results.length === 0) {
            status.textContent = `没有找到和“${query}”相关的文章。`;
            resultsContainer.innerHTML = `
                <div class="search-empty">
                    <strong>没有匹配结果</strong>
                    <p>可以换个关键词，或者试试搜索标签名。</p>
                </div>
            `;
            return;
        }

        status.textContent = `找到 ${results.length} 篇相关文章。`;
        resultsContainer.innerHTML = results
            .map(
                (result) => `
                    <article class="search-result-card">
                        <div class="result-card-header">
                            <a class="result-title" href="${result.url}">
                                ${highlight(result.title, terms)}
                            </a>
                            <time class="result-date" datetime="${escapeHtml(result.pubDate)}">
                                ${formatDate(result.pubDate)}
                            </time>
                        </div>
                        ${
                            result.tags.length > 0
                                ? `<div class="result-tags">${result.tags
                                      .map(
                                          (tag) =>
                                              `<a class="tag result-tag" href="/tags/${encodeURIComponent(tag)}"><span class="tag-label">${escapeHtml(tag)}</span></a>`,
                                      )
                                      .join("")}</div>`
                                : ""
                        }
                        <p class="result-description">
                            ${highlight(result.description, terms)}
                        </p>
                        <p class="result-snippet">
                            ${highlight(result.snippet, terms)}
                        </p>
                    </article>
                `,
            )
            .join("");
    };

    const runSearch = async (
        input: HTMLInputElement,
        status: HTMLElement,
        resultsContainer: HTMLElement,
    ) => {
        const query = input.value.trim();
        const terms = getTerms(query);

        if (terms.length === 0) {
            renderResults(resultsContainer, status, [], query, terms);
            return;
        }

        status.textContent = "正在搜索...";

        try {
            const index = await getSearchIndex();
            const results = index
                .map((post) => ({
                    ...post,
                    score: scorePost(post, terms),
                    snippet: createSnippet(post, terms),
                }))
                .filter((post) => post.score > 0)
                .sort((a, b) => {
                    if (b.score !== a.score) return b.score - a.score;
                    return (
                        new Date(b.pubDate).valueOf() -
                        new Date(a.pubDate).valueOf()
                    );
                });

            renderResults(resultsContainer, status, results, query, terms);
        } catch {
            status.textContent = "搜索索引加载失败，请稍后再试。";
        }
    };

    const initSearchPage = () => {
        const form = document.getElementById(
            "search-form",
        ) as HTMLFormElement | null;
        const input = document.getElementById(
            "site-search-input",
        ) as HTMLInputElement | null;
        const status = document.getElementById(
            "search-status",
        ) as HTMLElement | null;
        const resultsContainer = document.getElementById(
            "search-results",
        ) as HTMLElement | null;

        if (!form || !input || !status || !resultsContainer) return;

        const params = new URLSearchParams(window.location.search);
        input.value = params.get("q") ?? "";

        let debounceTimer: number | undefined;
        const scheduleSearch = () => {
            window.clearTimeout(debounceTimer);
            debounceTimer = window.setTimeout(() => {
                void runSearch(input, status, resultsContainer);
            }, 140);
        };

        form.addEventListener("submit", (event) => {
            event.preventDefault();
            const query = input.value.trim();
            const nextUrl = query
                ? `/search?q=${encodeURIComponent(query)}`
                : "/search";
            history.replaceState(null, "", nextUrl);
            void runSearch(input, status, resultsContainer);
        });

        input.addEventListener("input", scheduleSearch);
        void runSearch(input, status, resultsContainer);
    };

    document.addEventListener("astro:page-load", initSearchPage);
</script>

<style>
    .search-page {
        width: min(1120px, 100%);
        margin: 0 auto;
    }

    .search-hero {
        margin-bottom: 1.5rem;
        padding: clamp(1.4rem, 3.5vw, 2rem);
        border-radius: 14px;
        background: linear-gradient(180deg, var(--surface-1), var(--surface-2));
        border: 1px solid var(--surface-border);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.72),
            0 12px 28px var(--surface-shadow);
    }

    .search-hero h1 {
        margin-bottom: 1.1rem;
        font-size: clamp(1.6rem, 6vw, 2.4rem);
    }

    .search-form {
        margin: 0;
    }

    .search-input-shell {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.8rem;
        min-height: 3.7rem;
        padding: 0.4rem 0.5rem 0.4rem 1rem;
        border-radius: 11px;
        background: rgba(255, 255, 255, 0.84);
        border: 1px solid rgba(92, 88, 80, 0.16);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.9),
            0 4px 12px rgba(84, 70, 39, 0.06);
        transition:
            background 0.18s ease,
            border-color 0.18s ease,
            box-shadow 0.18s ease;
    }

    .search-input-shell:focus-within {
        background: rgba(255, 255, 255, 0.96);
        border-color: rgba(112, 87, 23, 0.42);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.94),
            0 0 0 3px rgba(112, 87, 23, 0.1),
            0 7px 16px rgba(84, 70, 39, 0.08);
    }

    .search-icon {
        color: var(--accent);
        font-size: 1.4rem;
        line-height: 1;
    }

    .search-input-shell input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: rgb(var(--black));
        font: inherit;
        font-size: 1rem;
        line-height: 1.5;
        padding: 0.45rem 0;
    }

    .search-input-shell input::placeholder {
        color: rgba(var(--gray), 0.78);
    }

    .search-submit-btn {
        justify-content: center;
        min-width: 5.2rem;
        padding: 0.48rem 1.15rem;
        font-weight: 700;
    }

    .search-status {
        margin: 0 0 1rem;
        color: rgb(var(--gray));
        font-size: 0.95rem;
    }

    .search-results {
        display: grid;
        gap: 1rem;
    }

    :global(.search-result-card),
    :global(.search-empty) {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
        padding: 1.2rem 1.3rem;
        background:
            linear-gradient(
                180deg,
                rgba(255, 255, 255, 0.98),
                rgba(248, 246, 241, 0.96)
            );
        border: 1px solid rgba(126, 103, 64, 0.12);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.88),
            0 8px 18px rgba(97, 82, 51, 0.07),
            0 16px 34px rgba(97, 82, 51, 0.05);
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease,
            border-color 0.18s ease;
    }

    :global(.search-result-card::before),
    :global(.search-empty::before) {
        content: "";
        position: absolute;
        inset: 0;
        background-image: var(--noise-texture);
        opacity: 0.055;
        pointer-events: none;
    }

    :global(.search-result-card::after) {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 4px;
        background: linear-gradient(
            180deg,
            rgba(112, 87, 23, 0.54),
            rgba(112, 87, 23, 0.14)
        );
        opacity: 0.8;
    }

    :global(.search-result-card:hover) {
        transform: translateY(-3px);
        border-color: rgba(112, 87, 23, 0.2);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.94),
            0 12px 22px rgba(97, 82, 51, 0.1),
            0 22px 42px rgba(97, 82, 51, 0.07);
    }

    :global(.result-card-header) {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.65rem;
    }

    :global(.result-title) {
        display: inline-block;
        color: rgb(var(--black));
        font-size: clamp(1.08rem, 2.4vw, 1.24rem);
        font-weight: 800;
        line-height: 1.3;
        text-decoration: none;
    }

    :global(.result-title:hover) {
        color: var(--accent);
    }

    :global(.result-date) {
        flex: 0 0 auto;
        margin-top: 0.08rem;
        padding: 0.18rem 0.55rem;
        border-radius: 999px;
        background: rgba(112, 87, 23, 0.09);
        color: var(--accent-dark);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1.45;
        white-space: nowrap;
    }

    :global(.result-tags) {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.75rem;
    }

    :global(.result-description),
    :global(.result-snippet),
    :global(.search-empty p) {
        position: relative;
        z-index: 1;
        margin: 0;
        color: rgb(var(--gray-dark));
        line-height: 1.7;
    }

    :global(.result-description) {
        margin-bottom: 0.55rem;
        font-weight: 700;
    }

    :global(.result-snippet) {
        padding: 0.75rem 0.85rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.54);
        border: 1px solid rgba(126, 103, 64, 0.08);
        font-size: 0.94rem;
    }

    :global(mark) {
        padding: 0.04rem 0.18rem;
        border-radius: 4px;
        background: rgba(112, 87, 23, 0.16);
        color: var(--accent-dark);
    }

    :global(html[data-theme="dark"]) .search-hero,
    :global(html[data-theme="dark"]) :global(.search-result-card),
    :global(html[data-theme="dark"]) :global(.search-empty) {
        background: linear-gradient(180deg, var(--surface-1), var(--surface-2));
        border-color: var(--surface-border);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.04),
            0 10px 24px var(--surface-shadow);
    }

    :global(html[data-theme="dark"]) :global(.search-result-card::after) {
        background: linear-gradient(
            180deg,
            rgba(212, 176, 103, 0.42),
            rgba(212, 176, 103, 0.1)
        );
    }

    :global(html[data-theme="dark"]) :global(.search-result-card:hover) {
        border-color: rgba(214, 183, 117, 0.22);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.06),
            0 12px 26px rgba(0, 0, 0, 0.28);
    }

    :global(html[data-theme="dark"]) :global(.result-date) {
        background: rgba(212, 176, 103, 0.12);
        border-color: rgba(214, 183, 117, 0.12);
        color: var(--accent);
    }

    :global(html[data-theme="dark"]) :global(.result-snippet) {
        background: rgba(255, 255, 255, 0.035);
        border-color: rgba(214, 183, 117, 0.1);
    }

    :global(html[data-theme="dark"]) .search-input-shell {
        background: rgba(30, 26, 22, 0.9);
        border-color: var(--surface-border);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.05),
            0 4px 12px rgba(0, 0, 0, 0.16);
    }

    :global(html[data-theme="dark"]) .search-input-shell:focus-within {
        background: rgba(38, 32, 27, 0.96);
        border-color: rgba(214, 183, 117, 0.34);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.06),
            0 0 0 3px rgba(212, 176, 103, 0.1),
            0 7px 16px rgba(0, 0, 0, 0.2);
    }

    :global(html[data-theme="dark"]) :global(mark) {
        background: rgba(212, 176, 103, 0.18);
        color: var(--accent-dark);
    }

    @media (max-width: 560px) {
        .search-page {
            width: calc(100% + 1.5rem);
            margin-left: -0.75rem;
        }

        .search-hero {
            padding: 1rem;
            border-radius: 12px;
        }

        .search-input-shell {
            grid-template-columns: auto minmax(0, 1fr) auto;
            gap: 0.5rem;
            min-height: 3.25rem;
            padding: 0.3rem 0.35rem 0.3rem 0.75rem;
        }

        .search-icon {
            font-size: 1.2rem;
        }

        .search-input-shell input {
            font-size: 0.95rem;
        }

        .search-submit-btn {
            min-width: auto;
            padding: 0.42rem 0.72rem;
        }

        :global(.result-card-header) {
            flex-direction: column;
            gap: 0.45rem;
        }

        :global(.result-date) {
            align-self: flex-start;
        }
    }
</style>
