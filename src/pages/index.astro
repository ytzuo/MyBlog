---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import aboutImage from "../assets/blog-placeholder-about.jpg";
import TagCloud from "../components/TagCloud.astro";
import Card from "../components/Cards/Card.astro";
import PostCard from "../components/Cards/PostCard.astro";
import GhostSprites from "../components/GhostSprites.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) =>
        new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

const latestPosts = posts.slice(0, 5);
const postCount = posts.length;

// 统计每个标签的使用频率
const tagFrequency = new Map<string, number>();
posts.forEach((post) => {
    (post.data.tags || []).forEach((tag) => {
        tagFrequency.set(tag, (tagFrequency.get(tag) ?? 0) + 1);
    });
});

// 按频率降序排列；频率相同时保留原始顺序（posts 已按日期降序，即最新优先）
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort(
    (a, b) => (tagFrequency.get(b) ?? 0) - (tagFrequency.get(a) ?? 0),
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <section class="top-section">
        <div class="intro-image">
            <Image src={aboutImage} alt="Profile" />
        </div>
        <div class="intro-text">
            <h1>Hi, 我是 Saten! 👋</h1>
            <p>
                欢迎来到我的小基地。这里记录了我的技术探索、生活感悟以及一些奇思妙想。
            </p>
        </div>
    </section>

    <div class="bottom-section">
        <!-- Sidebar -->
        <aside class="sidebar">
            <Card class="widget">
                <h3>站点统计</h3>
                <div class="stat-item">
                    <span>文章总数</span>
                    <strong>{postCount}</strong>
                </div>
                <div class="stat-item">
                    <span>标签数量</span>
                    <strong>{tags.length}</strong>
                </div>
            </Card>

            <TagCloud tags={tags} />
        </aside>

        <!-- Latest Posts -->
        <section class="latest-posts">
            <h2 class="section-title">最新博文</h2>
            <div class="post-list">
                {latestPosts.map((post) => <PostCard post={post} />)}
            </div>
            <div class="view-all">
                <a href="/blog">查看全部博文 &rarr;</a>
            </div>
        </section>
    </div>
    <GhostSprites />
</BaseLayout>

<style>
    /* Top Section */
    .top-section {
        display: flex;
        gap: 2rem;
        margin-bottom: 4rem;
        align-items: center;
    }
    .intro-image img {
        border-radius: 50%;
        width: 150px;
        height: 150px;
        object-fit: cover;
        box-shadow: var(--box-shadow);
        transition: transform 0.3s ease;
        transform-origin: center bottom;
    }
    .intro-image img:hover,
    .intro-image img.animate-shake {
        animation: shake 0.5s ease-in-out;
    }
    @keyframes shake {
        0%,
        100% {
            transform: rotate(0deg);
        }
        20% {
            transform: rotate(-10deg);
        }
        40% {
            transform: rotate(10deg);
        }
        60% {
            transform: rotate(-6deg);
        }
        80% {
            transform: rotate(6deg);
        }
    }
    .intro-text h1 {
        font-size: 2.5em;
        margin-bottom: 0.5em;
    }

    /* Bottom Section */
    .bottom-section {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 3rem;
    }

    /* Sidebar */
    .sidebar {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        position: sticky;
        top: 6rem;
        align-self: start;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }

    /* Latest Posts */
    .latest-posts h2 {
        margin-top: 0;
        margin-bottom: 1.5rem;
    }
    .post-list {
        display: flex;
        flex-direction: column;
    }

    @media (max-width: 720px) {
        .top-section {
            flex-direction: column;
            text-align: center;
        }
        .bottom-section {
            grid-template-columns: 1fr;
        }
        .sidebar {
            position: static;
        }
    }
</style>

<script>
    function triggerShake() {
        const img = document.querySelector(".intro-image img");
        if (img) {
            img.classList.add("animate-shake");
            setTimeout(() => {
                img.classList.remove("animate-shake");
            }, 500);
        }
    }

    document.addEventListener("astro:page-load", triggerShake);
</script>
