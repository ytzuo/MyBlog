---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../../layouts/BlogPost.astro";
import { getPostUrl, isEnglishPost } from "../../../lib/i18n";
import {
    assertUniquePostSlugs,
    isVisiblePost,
} from "../../../lib/posts";
import { getReadingStats } from "../../../lib/readingStats";

export async function getStaticPaths() {
    const posts = (await getCollection("blog")).filter(
        (post) => isVisiblePost(post) && isEnglishPost(post),
    );
    assertUniquePostSlugs(posts, "English");
    return posts.map((post) => ({
        params: { slug: post.data.slug },
        props: post,
    }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);
const readingStats = getReadingStats(post.body ?? "", "en");
const chineseTranslation = (await getCollection("blog")).find(
    (candidate) =>
        isVisiblePost(candidate) &&
        !isEnglishPost(candidate) &&
        candidate.data.slug === post.data.translationKey,
);
const alternateUrl = chineseTranslation
    ? getPostUrl(chineseTranslation)
    : "/blog/";
---

<BlogPost
    {...post.data}
    headings={headings}
    readingStats={readingStats}
    locale="en"
    alternateUrl={alternateUrl}
>
    <Content />
</BlogPost>
